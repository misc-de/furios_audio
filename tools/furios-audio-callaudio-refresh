# Give callaudiod a fresh view of the audio card after WirePlumber restarted.
#
# callaudiod looks the card up once and keeps its index. A WirePlumber restart
# destroys every device and creates it again with a new one - measured on
# 2026-09-11: card 161 before, card 248 after. callaudiod notices the new sinks
# and sources ("new sink 249") but never re-reads the card list, so the next
# call runs into this and stops there:
#
#   Change mode from '0', to '1'
#   card has voice profile, using it
#   <nothing - 25 seconds, then the D-Bus timeout>
#
# gnome-calls then reports "Failed to select audio mode: Timeout was reached",
# the card never reaches the voicecall profile, the HAL stays in
# AUDIO_MODE_NORMAL, and the call has no audio in either direction. Restarting
# a profile does this already (audioctl); this covers every other way
# WirePlumber comes back - an upgrade, a crash, someone typing systemctl.
#
# Starting callaudiod again is only half of it. If the method that activates it
# over D-Bus is SelectMode itself, the call arrives while callaudiod is still
# bringing its PulseAudio connection up and blocks just the same. So it is
# started here, with a method that asks nothing of it.
set -u

# Wait for the card first. This runs After=wireplumber.service, but WirePlumber
# is Type=simple: "started" means the process exists, not that it has built the
# card. After the crash on 2026-09-25 17:40 callaudiod was started 30 ms after
# WirePlumber, found no card ("No suitable card found, stopping here...") and
# kept running without one - the call that was going on had no audio in either
# direction, and so did every call after it until someone restarted callaudiod.
# A callaudiod started too early is worse than one started late: it looks alive.
card_ready() {
    pactl list cards 2>/dev/null | grep -q '^[[:space:]]*Name: droid$'
}
# In tenths of a second; the tests shorten it.
wait_tenths=${CALLAUDIO_REFRESH_WAIT:-200}
waited=0
until card_ready; do
    if [ "$waited" -ge "$wait_tenths" ]; then
        echo "the droid card did not appear - leaving callaudiod as it is"
        exit 0
    fi
    sleep 0.2
    waited=$((waited + 2))
done

# tonegend - ringback and DTMF tones - is Requires=pipewire-pulse.service,
# so it goes down with every PipeWire restart, and nothing brings it back:
# after the crash on 2026-10-03 09:17 it stayed dead for 22 hours. Starting it
# is harmless during a call too, so this comes before the check below.
if systemctl --user is-enabled tone-generator.service >/dev/null 2>&1; then
    systemctl --user start tone-generator.service >/dev/null 2>&1 \
        && echo "tonegend running again"
fi

# Never during a call. Taking callaudiod away mid-call would leave the card in
# the voicecall profile with nobody to bring it back. A WirePlumber restart at
# that moment has broken the call anyway; making it worse helps no one.
profile=$(pactl list cards 2>/dev/null |
          sed -n '/Name: droid$/,/^Card #/p' |
          sed -n 's/^[[:space:]]*Active Profile: //p')
if [ "$profile" = voicecall ]; then
    echo "a call is running - leaving callaudiod alone"
    exit 0
fi

pkill -x callaudiod 2>/dev/null && echo "callaudiod stopped - its card no longer exists"

# Read a property: that activates the service without asking it to do anything.
busctl --user get-property org.mobian_project.CallAudio \
    /org/mobian_project/CallAudio org.mobian_project.CallAudio AudioMode \
    >/dev/null 2>&1 || true
echo "callaudiod started again, with the card as it is now"

# feedbackd has the same blind spot, for every sound the phone makes. Its
# sound library keeps one connection to the sound server, and when PipeWire
# goes down while a sound is playing - the crash on 2026-10-03 09:17 hit the
# hang-up tone - that connection is left broken for good: every sound after it
# fails with "Invalid state", the ringtone included, until feedbackd itself is
# restarted. A clean restart leaves it alone (measured twice), a crash does
# not, and this script cannot tell them apart - so feedbackd starts fresh
# whenever WirePlumber does. It is D-Bus activated: stop it, wait until the
# name is really free, and activate it again, or the next ring finds nobody.
if pgrep -x feedbackd >/dev/null 2>&1; then
    pkill -x feedbackd 2>/dev/null
    gone=0
    while pgrep -x feedbackd >/dev/null 2>&1 && [ "$gone" -lt 20 ]; do
        sleep 0.1
        gone=$((gone + 1))
    done
    busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus StartServiceByName su org.sigxcpu.Feedback 0 \
        >/dev/null 2>&1 || true
    echo "feedbackd started again, with a fresh connection to the sound server"
fi
exit 0
