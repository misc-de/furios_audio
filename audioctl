#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2026 misc-de
# SPDX-License-Identifier: MIT
# audioctl - switch between the stock FuriOS audio stack and our own profiles.
# Nothing owned by dpkg is touched; everything works through masks and a
# drop-in in ~/.config/systemd/user and additive units under /usr/local, so
# none of it needs root. The way back is always 'audioctl revert'.
#
# This line used to say /etc/systemd/user, which stopped being true with
# f230cb3 and then sent somebody looking in the wrong place for a mask that
# an OLDER version had left there - see "An upgrade that took the switch with
# it" in FINDINGS.md.

set -u

# Every tool whose output is read here answers in one language. pactl info
# says "Servername:" on a German phone, and the "Server Name: " this looked
# for was never there - status said "Pulse server not reachable" on an FLX1
# set to de_DE whose server was running fine (4.10.2026), and the app showed
# the same. Nothing this starts shows text to anybody (the one process left
# running is paplay playing silence), so the whole script is set rather than
# each call: the next parse somebody adds cannot forget it.
export LC_ALL=C.UTF-8

# Overridable so the tests can run the real dispatcher without writing into
# the state of the phone they are running on.
STATE_DIR=${AUDIOCTL_STATE_DIR:-/var/lib/furios-audio}
STICKY=$STATE_DIR/profile
TRY=$STATE_DIR/profile.try

# The profile written here decides what furios-audio-apply.service applies at
# the next login, and that runs audioctl again - so a state directory anyone
# can write to hands the audio stack to anyone on the machine. Found exactly
# that on the phone this was developed on: /var/lib/furios-audio at 1777 and
# profile at 0666. Create it narrow, and say so rather than trust a wide one.
state_dir_ready() {
    [ -d "$STATE_DIR" ] || { mkdir -p "$STATE_DIR" 2>/dev/null || return 1; chmod 0755 "$STATE_DIR" 2>/dev/null; }
    perms=$(stat -c %a "$STATE_DIR" 2>/dev/null) || return 0
    case "$perms" in
    *[2367])
        # Ours to fix, or somebody else's to know about.
        chmod o-w,g-w "$STATE_DIR" 2>/dev/null \
            || warn "$STATE_DIR is writable by others ($perms) - anyone on this device can choose the audio profile"
        ;;
    esac
    return 0
}

# Write one line into a state file, readable by all and writable by nobody
# else. Without the umask the file inherits whatever the caller had.
write_state() {
    _f=$1 _v=$2
    state_dir_ready || return 1
    ( umask 022; printf '%s\n' "$_v" > "$_f" ) || return 1
    chmod 0644 "$_f" 2>/dev/null
}
# systemd --user reads ~/.config/systemd/user BEFORE /etc/systemd/user, and
# WirePlumber reads ~/.config/wireplumber the same way. Everything audioctl
# changes therefore lives in the user's own configuration - which is why none
# of this needs root any more, and why there is no helper, no pkexec and no
# sudoers line left to get wrong.
USERCFG=${XDG_CONFIG_HOME:-$HOME/.config}
ETCU=${AUDIOCTL_ETCU:-$USERCFG/systemd/user}
DROPIN=$ETCU/pipewire.service.d/50-furios-audio.conf
WPUSER=${AUDIOCTL_WPCONF_DIR:-$USERCFG/wireplumber/wireplumber.conf.d}
WPOFF=$WPUSER/99-furios-droid-off.conf
# Files can come from two sources: installed from the source tree
# (/usr/local) or from the package (/usr). Both have to be found.
first_existing() {
    local f
    for f in "$@"; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done
    printf '%s' "$1"
}
LOCAL=$(dirname "$(first_existing /usr/local/share/furios-audio/pipewire-hal.conf \
                                  /usr/share/furios-audio/pipewire-hal.conf)")

# --- what was there before the first switch ---------------------------------
#
# Everything audioctl writes under $HOME - masks and copies of five units, the
# pipewire drop-in, the droid-off file, the wants of our units and of
# WirePlumber, WirePlumber's saved settings - is recorded once, before the
# first write, and "audioctl original restore" (which uninstall.sh runs) puts
# back exactly that. The mechanism is tools/original-state.sh, shared with the
# install scripts; the user's record lives beside the headsets audioctl
# remembers, in ~/.config/furios-audio/original.
#
# It used to be a guess on the way out: every mask of those five units went,
# every want of wireplumber.service went - also one somebody had set up long
# before this repo was installed - and ~/.local/state/wireplumber went whole.
ORIG_USER_DIR=${AUDIOCTL_ORIGINAL_DIR:-$USERCFG/furios-audio/original}
# A caller that moved where audioctl writes (the tests do) but not where it
# records would get a record of temporary paths in the REAL ~/.config - and a
# later uninstall would take that for this phone's record. Found exactly so:
# the first full test run left 43 such entries in ~/.config/furios-audio.
# Without its own record directory such a caller records nothing.
ORIG_OFF=0
if [ -z "${AUDIOCTL_ORIGINAL_DIR:-}" ] \
   && [ -n "${AUDIOCTL_ETCU:-}${AUDIOCTL_STATE_DIR:-}${AUDIOCTL_WPCONF_DIR:-}" ]; then
    ORIG_OFF=1
fi
WPSTATE=${AUDIOCTL_WPSTATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/wireplumber}
# Our user units and every place "enable" puts a want for them.
OUR_USER_UNITS="furios-audio-apply.service furios-audio-verify.service furios-pw-tunnel.service
    furios-audio-pause-on-disconnect.service furios-audio-callaudio-refresh.service
    furios-audio-sco-hold.service furios-audio-bt-mic.service furios-audio-bt-reconnect.service
    furios-audio-ringback.service"
OUR_WANT_TARGETS="default.target graphical-session.target wireplumber.service"
# Next to this file in the work tree, else where either install put it.
ORIG_LIB=$(first_existing "$(dirname "${BASH_SOURCE[0]}")/tools/original-state.sh" \
                          "$LOCAL/original-state.sh" \
                          /usr/local/share/furios-audio/original-state.sh \
                          /usr/share/furios-audio/original-state.sh)
if [ -r "$ORIG_LIB" ]; then
    # shellcheck source=tools/original-state.sh
    . "$ORIG_LIB"
    ORIG_OK=1
else
    ORIG_OK=0
fi

# Where the built plugin and PipeWire's own modules live.
#
# Overridable for the same reason ETCU is, and for a reason that had already
# happened: plugin_version_check read this path as a literal, so the test that
# claims to check it read the PHONE's installation instead of the stub it had
# just set up. It passed here and failed on a runner that has no plugin at
# all - the check was measuring the machine, not the code. Same shape as the
# test that read /etc while believing it read the stub.
PLUGIN_DIR=${AUDIOCTL_PLUGIN_DIR:-/usr/lib/aarch64-linux-gnu/spa-0.2/droid}
PWMODULE_DIR=${AUDIOCTL_PW_MODULE_DIR:-/usr/lib/aarch64-linux-gnu/pipewire-0.3}

# The helper that writes the +CLCC-fixed copy of libspa-bluez5.so before
# WirePlumber starts (tools/furios-audio-bluez5-fix.py). Its --check says what
# the next WirePlumber start will do with the library installed NOW - which is
# what status has to show after a PipeWire update, before anybody restarts.
# Next to this file in the work tree first, like ORIG_LIB below: an older
# installed helper has no --check and would do its WirePlumber-start job.
BLUEZ5_FIX=${AUDIOCTL_BLUEZ5_FIX:-$(first_existing "$(dirname "${BASH_SOURCE[0]}")/tools/furios-audio-bluez5-fix.py" \
                                                   /usr/local/bin/furios-audio-bluez5-fix \
                                                   /usr/bin/furios-audio-bluez5-fix)}
# The work tree's copy is not executable; the installed ones are.
bluez5_fix_check() {
    [ -e "$BLUEZ5_FIX" ] || return 1
    case "$BLUEZ5_FIX" in
    *.py) python3 "$BLUEZ5_FIX" --check 2>/dev/null ;;
    *)    "$BLUEZ5_FIX" --check 2>/dev/null ;;
    esac
}

PROFILES="standard pw-tunnel pw-hal"
DRY=0
# Set by the "boot" command: write the configuration, start nothing. See uctl().
BOOT=0

die()  { printf 'audioctl: %s\n' "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }
warn() { printf 'audioctl: %s\n' "$*" >&2; }
run()  { if [ "$DRY" = 1 ]; then printf '  [dry] %s\n' "$*"; else "$@"; fi; }


# At boot furios-audio-apply.service runs Before= the very units a profile
# switch restarts - so asking systemd for that restart there waits for a job
# that is waiting for us. The deadlock held the entire session: pipewire never
# started, default.target never finished, and the phone came up silent with a
# masked PulseAudio, because a switch had got half-way through.
#
# Nothing needs starting at that point anyway. Only the configuration is
# written, and systemd starts the stack from it moments later. "--now" goes the
# same way: "enable" is configuration and stays, starting it here is not.
uctl() {
    if [ "$BOOT" = 1 ]; then
        case "$1" in
        start|stop|restart|reset-failed) return 0 ;;
        enable|disable)
            local verb=$1; shift
            [ "${1:-}" = --now ] && shift
            set -- "$verb" "$@" ;;
        esac
    fi
    systemctl --user "$@"
}

# --- the three things a profile switch changes ------------------------------
#
# None of them needs root: systemd and WirePlumber both look in the user's
# configuration first, so masking a unit, dropping in a different ExecStart and
# turning the droid monitor off all happen under $HOME.
#
# This used to be furios-audio-helper behind pkexec, with a sudo fallback for
# the boot-time safety net - and that fallback is why FuriOS shipping
# "furios ALL=(ALL) NOPASSWD:ALL" mattered to us at all. It does not any more.

# The units a profile switch is allowed to touch. Masking is a symlink to
# /dev/null, and doing that to the wrong unit is how a session stops coming up.
known_unit() {
    case "$1" in
    pipewire-pulse.service|pipewire-pulse.socket|wireplumber.service|\
    pulseaudio.service|pulseaudio.socket) return 0 ;;
    esac
    return 1
}

do_mask() {
    for u in "$@"; do
        known_unit "$u" || { warn "refusing to mask \"$u\" - not one of ours"; return 1; }
    done
    mkdir -p "$ETCU" || return 1
    for u in "$@"; do
        ln -sf /dev/null "$ETCU/$u" || { warn "could not mask $u"; return 1; }
    done
    return 0
}

do_unmask() {
    for u in "$@"; do
        known_unit "$u" || { warn "refusing to unmask \"$u\" - not one of ours"; return 1; }
    done
    for u in "$@"; do
        # Only our own kind of mask, never a real file someone put there.
        if [ -L "$ETCU/$u" ] && [ "$(readlink "$ETCU/$u")" = /dev/null ]; then
            rm -f "$ETCU/$u" || { warn "could not unmask $u"; return 1; }
        fi
        # A mask below ours - FuriOS ships three in /etc/systemd/user - is
        # covered by a copy, and a copy we made once is kept current.
        if system_masked "$u" || is_shadow "$ETCU/$u"; then
            shadow_write "$u" || return 1
        fi
    done
    return 0
}

# Units masked below $HOME, which we must not remove.
#
# furios-quirks-device ships pipewire-pulse.service, pipewire-pulse.socket and
# wireplumber.service in /etc/systemd/user as links to /dev/null. An earlier
# "audioctl migrate" deleted them - package files - and the next update of that
# package would have put them back and taken pw-hal down with it at every boot.
#
# A link to the original in ~/.config does NOT get past such a mask: systemd
# resolves it into the search path, finds the mask and reports "Too many
# levels of symbolic links" (tried on the phone, systemd 261). A regular file
# does - it is the first fragment found, and the mask below it is never read.
# So the copy is a plain file with a marker, rewritten from the original at
# every login (apply runs at boot), which keeps it from going stale after a
# PipeWire or WirePlumber update changes the unit.
VENDOR_UNITS=${AUDIOCTL_VENDOR_UNITS:-"/usr/local/lib/systemd/user /usr/lib/systemd/user"}
SHADOW_MARK='# furios-audio: copy of'
system_masked() { legacy_masked "$1"; }
is_shadow() {
    [ -f "$1" ] && [ ! -L "$1" ] && head -n1 "$1" 2>/dev/null | grep -q "^$SHADOW_MARK "
}
vendor_unit() {
    local d
    for d in $VENDOR_UNITS; do
        [ -f "$d/$1" ] && [ ! -L "$d/$1" ] && { printf '%s' "$d/$1"; return 0; }
    done
    return 1
}
shadow_write() {
    local u=$1 src tmp
    # Never over a file somebody else put there.
    if [ -e "$ETCU/$u" ] && ! is_shadow "$ETCU/$u"; then
        warn "$ETCU/$u is not ours - leaving it, $u stays as it is"
        return 1
    fi
    src=$(vendor_unit "$u") || { warn "no unit file for $u in $VENDOR_UNITS - it stays masked"; return 1; }
    mkdir -p "$ETCU" || return 1
    tmp=$(mktemp "$ETCU/.$u.XXXXXX") || return 1
    { printf '%s %s - the system masks it, this copy outranks the mask.\n' "$SHADOW_MARK" "$src"
      printf '# Rewritten by audioctl at every login; do not edit.\n'
      cat "$src"; } > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$ETCU/$u" \
        || { rm -f "$tmp"; warn "could not write $ETCU/$u"; return 1; }
}

mask()   { run do_mask "$@"; }
unmask() { run do_unmask "$@"; }

dropin_write() {
    [ -e "$LOCAL/pipewire-hal.conf" ] || { warn "no pipewire-hal.conf in $LOCAL"; return 1; }
    mkdir -p "$(dirname "$DROPIN")" || return 1
    printf '[Service]\nExecStart=\nExecStart=/usr/bin/pipewire -c %s/pipewire-hal.conf\n' \
        "$LOCAL" > "$DROPIN"
}

dropin_remove() { rm -f "$DROPIN"; }

# What an older version left in /etc, which we can no longer write and no
# longer need.
#
# systemd reads ~/.config/systemd/user first, but only for units that are
# actually there: a mask still sitting in /etc/systemd/user keeps masking, and
# a drop-in there keeps applying. So say so, once, with the command that clears
# it - rather than silently fighting a state we cannot reach.
# Overridable so the tests can point this at a stub. Without that they read
# the real /etc while believing they read AUDIOCTL_ETCU, and "audioctl migrate"
# then passes or fails depending on what the phone happens to have lying
# around - which is how this check failed on a machine whose code was fine.
# As root every AUDIOCTL_* override is refused further down, so this cannot
# turn migrate into a way of deleting arbitrary files.
LEGACY_ETCU=${AUDIOCTL_LEGACY_ETCU:-/etc/systemd/user}
LEGACY_WP=${AUDIOCTL_LEGACY_WP:-"/usr/local/share/wireplumber /usr/share/wireplumber"}
legacy_masked() {
    [ -L "$LEGACY_ETCU/$1" ] && [ "$(readlink "$LEGACY_ETCU/$1")" = /dev/null ]
}
legacy_dropin() {
    f="$LEGACY_ETCU/pipewire.service.d/50-furios-audio.conf"
    [ -e "$f" ] && printf '%s' "$f"
    return 0
}
legacy_droid_off() {
    out=
    for d in $LEGACY_WP; do
        f="$d/wireplumber.conf.d/50-droid.conf.off"
        [ -e "$f" ] && out="$out $f"
    done
    printf '%s' "${out# }"
}
# Masks are not on this list any more. Three of them belong to
# furios-quirks-device, and a mask of any origin is covered by a copy under
# $HOME (see shadow_write) - removing one is never needed and, for a package
# file, wrong.
# The AAC module an older tools/build-bluez5-aac.sh installed with sudo
# beside Debian's codecs, with its version note. It is loaded whatever
# PipeWire it was built for; the module now lives under the user's
# ~/.local/share. A file a package owns is Debian's, never a leftover.
LEGACY_SPA=${AUDIOCTL_LEGACY_SPA:-/usr/lib/aarch64-linux-gnu/spa-0.2/bluez5}
legacy_aac() {
    out=
    for f in "$LEGACY_SPA/libspa-codec-bluez5-aac.so" "$LEGACY_SPA/aac-built-against"; do
        [ -e "$f" ] || continue
        dpkg -S "$f" >/dev/null 2>&1 && continue
        out="$out $f"
    done
    printf '%s' "${out# }"
}
legacy_leftovers() {
    out=
    f=$(legacy_dropin);    [ -n "$f" ] && out="$out $f"
    f=$(legacy_droid_off); [ -n "$f" ] && out="$out $f"
    f=$(legacy_aac);       [ -n "$f" ] && out="$out $f"
    printf '%s' "${out# }"
}

# Which units a profile needs to be able to START. Read by apply(), which
# unmasks exactly these - under $HOME, and past a mask in /etc by a copy.
#
# Kept in one place on purpose. The list was going to be written out
# twice, and a check that believes a switch needs pulseaudio while the switch
# actually needs wireplumber is worse than no check: it passes, and then the
# switch fails anyway.
profile_unmasks() {
    case "$1" in
    standard)  printf 'pulseaudio.service pulseaudio.socket' ;;
    pw-tunnel) printf 'pulseaudio.service pulseaudio.socket wireplumber.service' ;;
    pw-hal)    printf 'pipewire-pulse.service pipewire-pulse.socket wireplumber.service' ;;
    esac
}

# Of the leftovers, the ones that would defeat a switch to THIS profile.
#
# Not simply "is there anything left over": refusing over something a profile
# does not care about would block "audioctl revert" and "audioctl rescue", the
# two commands whose whole job is to get sound back. Masks never block - a
# copy under $HOME gets past them (shadow_write).
#
# The drop-in: standard and pw-tunnel REMOVE it, so the
# copy in /etc would go on applying to pipewire. pw-hal writes its own under
# $HOME, which systemd reads first, so for pw-hal it is harmless. And a droid
# monitor renamed to .off is missing for pw-hal alone - the other two profiles
# do not want it running.
# Underscored throughout: bash scopes dynamically, so a plain "p=$1" here
# would assign to the caller's "local p" - and switch_to's p is the profile
# being switched to.
blocking_leftovers() {
    _p=$1 _out= _f=
    case "$_p" in
    standard|pw-tunnel) _f=$(legacy_dropin) ;;
    pw-hal)             _f=$(legacy_droid_off) ;;
    esac
    [ -n "$_f" ] && _out="$_out $_f"
    printf '%s' "${_out# }"
}

warn_about_legacy() {
    left=$(legacy_leftovers)
    [ -z "$left" ] && return 0
    warn "an older version left system-wide state behind, and it still wins:"
    for f in $left; do warn "    $f"; done
    warn "  audioctl no longer needs root and cannot clear these itself. Once:"
    warn "    sudo audioctl migrate"
    return 0
}

# Say something whatever the situation - but REFUSE only when this particular
# switch cannot work.
#
# It used to warn and carry on. The warning was true and the switch was
# doomed: enable bounced off the mask, verify waited its fifteen seconds for a
# sink that could not appear, and the last line said "standard restored". A
# dozen lines of fallout with the cause buried at the top reads like a broken
# switch, not like a leftover from an older version. Stopping at the cause is
# both shorter and the only honest answer.
#
# Never at boot. furios-audio-apply.service runs this at every login, it must
# write the configuration for the stored profile whatever else is lying
# around, and a phone that refuses to set itself up until someone has run a
# command over ssh is worse off than one that warns.
check_legacy() {
    _p=$1 _mode=$2 _blocking=
    [ "$_mode" = boot ] && { warn_about_legacy; return 0; }
    _blocking=$(blocking_leftovers "$_p")
    [ -z "$_blocking" ] && { warn_about_legacy; return 0; }
    warn "not switching to \"$_p\": an older version left state behind that"
    warn "this version cannot clear, and that would defeat the switch:"
    for f in $_blocking; do warn "    $f"; done
    warn "  Clear it once - this is the only thing that still wants root:"
    warn "    sudo audioctl migrate"
    warn "  Then try again. Nothing has been changed."
    return 1
}

# Clear exactly those leftovers, and nothing else. The only thing in audioctl
# that wants root, run once by hand.
migrate_legacy() {
    [ "$(id -u)" = 0 ] || die "run this one as root: sudo audioctl migrate"
    left=$(legacy_leftovers)
    [ -z "$left" ] && { info "nothing left over - already migrated"; return 0; }
    for f in $left; do
        case "$f" in
        "$LEGACY_ETCU"/*|*/wireplumber.conf.d/50-droid.conf.off) ;;
        "$LEGACY_SPA"/libspa-codec-bluez5-aac.so|"$LEGACY_SPA"/aac-built-against) ;;
        *) warn "refusing to touch $f"; continue ;;
        esac
        if [ "${f%.off}" != "$f" ]; then
            run mv "$f" "${f%.off}" && info "restored ${f%.off}"
        else
            run rm -f "$f" && info "removed $f"
        fi
    done
    run systemctl --global daemon-reload 2>/dev/null
    info "done - the profile now lives under \$HOME and needs no root"
    return 0
}

# Is this one of ours? Everything that comes out of a state file goes through
# here first.
known_profile() {
    case " $PROFILES " in *" $1 "*) return 0 ;; esac
    return 1
}

# What the state files say - but never something that is not a profile.
#
# The content used to be passed on unread. A file that had been truncated, or
# written by an older version, or simply damaged, then reached preflight() and
# killed "audioctl boot" with "unknown profile" - the one command that runs at
# every boot and whose whole job is to leave the phone in a state that makes
# sound. Falling back to standard is what the rest of this file does whenever
# it does not know better; do it here too, and say so.
current_profile() {
    local p=""
    [ -r "$TRY" ]    && p=$(cat "$TRY"    2>/dev/null)
    [ -n "$p" ] || { [ -r "$STICKY" ] && p=$(cat "$STICKY" 2>/dev/null); }
    [ -n "$p" ] || { printf 'standard'; return; }
    if known_profile "$p"; then
        printf '%s' "$p"
    else
        warn "stored profile \"$p\" is not one of ours - using standard"
        printf 'standard'
    fi
}

# What is REALLY running? The state file can go stale - which is exactly what
# misled the first call test: status reported pw-hal while PulseAudio was
# actually running, and the call tested the wrong stack.
effective_profile() {
    if uctl is-active pulseaudio.service >/dev/null 2>&1; then
        if uctl is-active furios-pw-tunnel.service >/dev/null 2>&1; then
            printf 'pw-tunnel'
        else
            printf 'standard'
        fi
    elif uctl is-active pipewire-pulse.service >/dev/null 2>&1; then
        printf 'pw-hal'
    else
        printf 'unclear'
    fi
}

pulse_owner() {
    local s
    s=$(pactl info 2>/dev/null | sed -n 's/^Server Name: //p')
    [ -n "$s" ] && printf '%s' "$s" || printf 'not reachable'
}

# Does the plugin still match the installed PipeWire version?
#
# The plugin is built against a specific SPA interface. If a system update
# breaks it, pw-hal would go silent without a word - the auto-revert catches
# that, but a warning beforehand saves the search.
plugin_version_check() {
    local dir=$PLUGIN_DIR built now
    [ -r "$dir/built-against" ] || return 0
    built=$(cat "$dir/built-against")
    if [ "$built" = unknown ] || [ -z "$built" ]; then
        # Written by an install-hal.sh that could not tell (before
        # tools/pw-version.sh). Not a mismatch, and not a reason for "If
        # there is no sound" at every switch: the version is simply missing.
        printf 'NOTE: the plugin does not record which PipeWire it was built against.\n' >&2
        printf '      Run ./install-hal.sh again in the project directory to record it.\n' >&2
        return 0
    fi
    now=$(pkg-config --modversion libpipewire-0.3 2>/dev/null)
    [ -n "$now" ] || now=$(pipewire --version 2>/dev/null | sed -n 's/.*libpipewire \([0-9.]*\).*/\1/p' | head -1)
    [ -n "$now" ] || return 0
    if [ "$built" != "$now" ]; then
        printf 'WARNING: the plugin was built against PipeWire %s, installed is %s.\n' \
            "$built" "$now" >&2
        printf '         If there is no sound: rebuild in the project directory and\n' >&2
        printf '         run ./install-hal.sh again.\n' >&2
    fi
    return 0
}

# The hand-built AAC codec module has the same problem, for Bluetooth.
#
# Debian ships no AAC module, so most earbuds fall back to SBC - see
# tools/build-bluez5-aac.sh. That module is built against libspa-bluez5's
# internal codec interface. It lives under the user's ~/.local/share, and
# furios-audio-bluez5-fix offers it to WirePlumber only while the
# libspa-bluez5.so it was built for is the installed one - so a stale module
# is never loaded; this only says why AAC is gone. And it names a module an
# older build script left in the system directory, which IS loaded whatever
# its age.
aac_version_check() {
    local out state reason legacy
    [ -e "$BLUEZ5_FIX" ] || return 0
    out=$(bluez5_fix_check) || return 0
    state=$(printf '%s\n' "$out" | sed -n 's/^aac=//p' | head -1)
    reason=$(printf '%s\n' "$out" | sed -n 's/^aac-reason=//p' | head -1)
    legacy=$(printf '%s\n' "$out" | sed -n 's/^aac-legacy=//p' | head -1)
    if [ "$state" = stale ]; then
        printf 'NOTE: the Bluetooth AAC module is not loaded: %s.\n' "$reason" >&2
        printf '      Bluetooth music uses SBC until it is rebuilt:\n' >&2
        printf '      ./tools/build-bluez5-aac.sh\n' >&2
    fi
    if [ -n "$legacy" ]; then
        printf 'NOTE: an AAC module from an older build is in %s\n' "$legacy" >&2
        printf '      and is loaded whatever PipeWire it was built for. Once:\n' >&2
        printf '      sudo audioctl migrate\n' >&2
    fi
    return 0
}

# WirePlumber's droid monitor may only run when PipeWire is meant to hold the
# HAL. In the pw-tunnel profile PulseAudio holds it - if the monitor started
# there it would reach for the same device.
# The system file that loads the monitor (50-droid.conf in /usr/share) is never
# touched. Turning the monitor off is a file of our own in the user's
# configuration, read after it and switching the components to "disabled";
# turning it on again is removing that file. WirePlumber reads conf.d in
# alphabetical order, so 99- wins over 50-.
droid_monitor_off_file() {
    mkdir -p "$WPUSER" || return 1
    cat > "$WPOFF" <<'WPEOF'
# Written by audioctl for the pw-tunnel profile, removed again for the others.
#
# There PulseAudio owns the Android HAL, and the droid monitor would reach for
# the same device. This turns the components off without touching the system
# file that declares them.
wireplumber.profiles = {
  main = {
    monitor.droid = disabled
    policy.droid-input-follows-output = disabled
    policy.droid-default-sink-policy = disabled
    policy.droid-bluetooth-call = disabled
    policy.droid-bluetooth-codec = disabled
    policy.droid = disabled
  }
}
WPEOF
}

droid_monitor() {
    case "$1" in
    on)  [ -e "$WPOFF" ] && run rm -f "$WPOFF" ;;
    off) [ -e "$WPOFF" ] || run droid_monitor_off_file ;;
    esac
    return 0
}

# --- preconditions per profile ---------------------------------------------
preflight() {
    case "$1" in
    standard) : ;;
    pw-tunnel)
        [ -e "$PWMODULE_DIR/libpipewire-module-pulse-tunnel.so" ] \
            || die "libpipewire-module-pulse-tunnel.so is missing."
        [ -e "$LOCAL/tunnel.conf" ] || die "$LOCAL/tunnel.conf is missing."
        ;;
    pw-hal)
        plugin_version_check
        aac_version_check
        [ -e "$PLUGIN_DIR/libspa-droid.so" ] \
            || die "SPA droid plugin not built yet - the pw-hal profile stays locked until then."
        command -v wireplumber >/dev/null \
            || die "wireplumber is not installed (apt install wireplumber)."
        ;;
    *) die "unknown profile '$1'. Known: $PROFILES" ;;
    esac
}

# --- apply profiles ---------------------------------------------------------
apply() {
    local p=$1
    known_profile "$p" || { warn "refusing to apply \"$p\" - not a profile"; return 1; }
    case "$p" in
    standard)
        pw_helpers stop
        droid_monitor on
        run uctl stop furios-pw-tunnel.service 2>/dev/null
        run uctl disable furios-pw-tunnel.service 2>/dev/null
        # Masking does not stop a RUNNING service - stop it first, otherwise
        # pipewire-pulse keeps holding the Pulse socket.
        run uctl stop pipewire-pulse.service pipewire-pulse.socket 2>/dev/null
        run uctl stop wireplumber.service 2>/dev/null
        # Give the want back too, not just the running service - see the
        # pw-hal branch below for why it is there at all.
        run uctl disable wireplumber.service 2>/dev/null
        mask   pipewire-pulse.service pipewire-pulse.socket wireplumber.service
        # shellcheck disable=SC2046  # the list is deliberately split
        unmask $(profile_unmasks "$p")
        run dropin_remove
        run uctl daemon-reload
        # A failed pw-hal leaves pipewire in 'failed' - without reset-failed
        # the camera would stay dead. Reset first, then start.
        run uctl reset-failed pipewire.service 2>/dev/null
        run uctl restart pipewire.service
        # restart rather than start: pipewire-pulse takes the socket down with
        # it, so a plain start would not recreate it.
        run uctl restart pulseaudio.socket pulseaudio.service
        ;;
    pw-tunnel)
        # PulseAudio keeps the HAL and the Pulse socket. PipeWire additionally
        # gets a tunnel sink. Telephony is untouched.
        #
        # WirePlumber MUST run here: without a session manager nobody links the
        # streams and the tunnel sink would stay unused - which is exactly how
        # this profile failed on its first test. Its droid monitor stays off,
        # otherwise it would reach for the HAL that PulseAudio holds.
        pw_helpers stop
        droid_monitor off
        mask   pipewire-pulse.service pipewire-pulse.socket
        # shellcheck disable=SC2046
        unmask $(profile_unmasks "$p")
        run dropin_remove
        run uctl daemon-reload
        run uctl start pulseaudio.socket pulseaudio.service
        run uctl enable wireplumber.service
        run uctl restart wireplumber.service
        run uctl enable --now furios-pw-tunnel.service
        ;;
    pw-hal)
        # PipeWire takes over the HAL. PulseAudio has to give way (the HAL is
        # exclusive).
        droid_monitor on
        run uctl stop furios-pw-tunnel.service 2>/dev/null
        run uctl disable furios-pw-tunnel.service 2>/dev/null
        run uctl stop pulseaudio.service pulseaudio.socket
        mask   pulseaudio.service pulseaudio.socket
        # shellcheck disable=SC2046
        unmask $(profile_unmasks "$p")
        # The drop-in is generated rather than a fixed file linked into place:
        # the path to the configuration depends on whether the install came
        # from the source tree (/usr/local) or from the package (/usr). The
        # helper works that out itself - it takes no path from here.
        if [ "$DRY" = 1 ]; then
            printf '  [dry run] write %s (-c %s/pipewire-hal.conf)\n' \
                "$DROPIN" "$LOCAL"
        else
            dropin_write
        fi
        run uctl daemon-reload
        # Nothing on this system wants WirePlumber. Its [Install] says
        # WantedBy=pipewire.service, but the want is only written when someone
        # enables it, and audioctl never did - it started the service by hand
        # and that was enough for as long as nobody looked past the session.
        #
        # Across a reboot it is not enough: pipewire comes back, no session
        # manager comes with it, no card is ever created and the phone is
        # silent on a profile that works perfectly when switched to by hand.
        # "enable" writes the want into ~/.config/systemd/user, where the
        # first transaction of the next boot can already see it.
        run uctl enable wireplumber.service
        run uctl restart pipewire.service
        run uctl start wireplumber.service pipewire-pulse.socket pipewire-pulse.service
        ;;
    esac
}

# --- verification: is there a usable sink? ----------------------------------
verify() {
    # Fifteen seconds is what a real switch needs; the tests set it to one, so
    # a suite that exercises this path does not spend minutes asleep.
    # The boot check passes its own number here: a boot is slower than a
    # switch on a warm system. Through the environment the larger value would
    # have stayed in force for every later call in the same run.
    local i=0 tries=${1:-${VERIFY_TRIES:-15}}
    while [ $i -lt "$tries" ]; do
        # auto_null is PipeWire's fallback sink: it exists precisely when no
        # real device came up. Accepting it would let the safety net pass on a
        # plugin that failed to load - the switch would look successful and
        # leave the phone silent, which is the one case this check exists for.
        # NF skips blank lines: a stray empty line would otherwise count as
        # a sink, and this is the check the auto-revert hangs on.
        if pactl list sinks short 2>/dev/null | awk 'NF {print $2}' \
                | grep -qvx auto_null; then
            return 0
        fi
        i=$((i+1)); sleep 1
    done
    return 1
}

# --- after the stack: did the stored profile actually produce sound? --------
#
# "audioctl boot" writes the configuration before the stack starts and so
# cannot judge it - there is nothing up yet to ask. This runs afterwards, from
# furios-audio-verify.service, and is the only place where a profile that comes
# up silent is caught. Without it a stored pw-hal that breaks - a plugin no
# longer matching a new PipeWire, say - leaves the phone mute with no way back
# except a command line.
#
# It allows the stack twice as long as an interactive switch. A boot is slower
# than a switch on a warm system, and a fallback that fires because the HAL was
# merely slow would be worse than what it guards against.
# Whether the phone's own output is there - not just any sink. Under pw-hal
# a Bluetooth headset or a USB DAC can come up while the HAL gave PipeWire
# nothing, and speaker, earpiece and calls would stay silent behind a check
# that passed.
phone_sink_up() {
    local i=0 tries=${1:-1}
    while [ "$i" -lt "$tries" ]; do
        pactl list sinks short 2>/dev/null | awk 'NF {print $2}' \
            | grep -qx 'droid-sink' && return 0
        i=$((i+1))
        [ "$i" -lt "$tries" ] && sleep 1
    done
    return 1
}

# Where the boot check notes that it fell back, for status and the app.
FELL_BACK=$STATE_DIR/fell-back

boot_check() {
    local p sinks ok=0
    p=$(current_profile)
    if verify "${BOOT_VERIFY_TRIES:-30}"; then
        case "$p" in
            pw-hal) phone_sink_up "${BOOT_VERIFY_TRIES:-30}" && ok=1 ;;
            *)      ok=1 ;;
        esac
    fi
    if [ "$ok" = 1 ]; then
        sinks=$(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, -)
        printf 'boot check: profile %s has a sink (%s)\n' "$p" "$sinks"
        return 0
    fi
    printf 'boot check: profile %s produced no phone output. Falling back to standard.\n' "$p" >&2
    # A WirePlumber stuck in a HAL call would hold the stop in apply for its
    # full stop timeout, and this unit's own timeout could then kill the
    # fallback half way - WirePlumber masked, PulseAudio not started.
    uctl kill -s KILL wireplumber.service >/dev/null 2>&1 || true
    apply standard
    rm -f "$TRY"
    # Recorded, not only applied (changed 28.9.): a profile that does not come
    # up after an update would otherwise be tried again at every boot - half a
    # minute of silence each time, and with standard's masks still in place
    # the next boot cannot bring it back anyway. The worst case is to be the
    # shipped default. The note says when and from what, so status and the
    # app can tell somebody why the phone is on PulseAudio again.
    write_state "$STICKY" standard 2>/dev/null || true
    write_state "$FELL_BACK" "$(date '+%F %T') $p" 2>/dev/null || true
    if verify; then
        # callaudiod and feedbackd still hold the server that just went away:
        # no ringtone and no call routing until they are restarted.
        restart_audio_clients
        printf 'boot check: standard restored.\n'
        return 0
    fi
    # Left failed on purpose: this is the one state nobody can hear their way
    # out of, and "systemctl --user --failed" is where it belongs.
    printf 'boot check: standard delivers no sink either.\n' >&2
    return 1
}

# callaudiod and feedbackd hold persistent connections to the audio server.
# A profile switch changes the server - afterwards callaudiod finds no card any
# more ("No suitable card found") and feedbackd fails with "Invalid state": no
# ringtone, only vibration. Killing them is enough, D-Bus starts both again on
# the next call.
#
# Not before the card is there, though. Killed straight after the switch,
# callaudiod came back through D-Bus before WirePlumber had built the phone
# card, logged "No suitable card found, stopping here..." and ran on without
# one (2026-09-25 18:14:45) - alive, and deaf to every call. So this waits
# for a card with a call profile first. If none turns up it restarts them
# anyway, as it always did: a profile whose card is named differently must
# not lose its ringtone to this.
wait_for_call_card() {
    local i=0 tries=${CALL_CARD_TRIES:-20}
    while [ "$i" -lt "$tries" ]; do
        pactl list cards 2>/dev/null \
            | grep -qiE '^[[:space:]]+[a-z0-9_-]*voice[a-z0-9_-]*:' && return 0
        i=$((i+1)); sleep 0.5
    done
    return 1
}

restart_audio_clients() {
    local restarted=""
    [ "$DRY" = 1 ] || wait_for_call_card \
        || info "no card with a call profile yet - restarting callaudiod anyway"
    pkill -x callaudiod 2>/dev/null && restarted="callaudiod"
    pkill -x feedbackd  2>/dev/null && restarted="${restarted:+$restarted, }feedbackd"
    [ -n "$restarted" ] && info "restarted: $restarted (D-Bus activates them on demand)"
    warm_callaudiod
    return 0
}

# Start callaudiod now, rather than letting the first call pay for it.
#
# Measured on 2026-09-11: when SelectMode is the method that activates
# callaudiod over D-Bus, it arrives while callaudiod is still bringing its
# PulseAudio connection up ("PA not ready") and blocks until the D-Bus
# timeout - 25 seconds, twice out of two tries against our stack, never
# against the shipped one. gnome-calls then logs "Failed to select audio mode:
# Timeout was reached", the card never reaches the voicecall profile, and the
# call has no audio in either direction. That is what a first call after every
# profile switch looked like, because switching kills callaudiod.
#
# Reading a property activates the service without asking it to do anything,
# and after that SelectMode answers in about a second. A failure here is not
# worth reporting: the worst case is the state we were in anyway.
warm_callaudiod() {
    command -v busctl >/dev/null 2>&1 || return 0
    [ "$DRY" = 1 ] && { printf '  [dry] warm up callaudiod\n'; return 0; }
    busctl --user get-property org.mobian_project.CallAudio \
        /org/mobian_project/CallAudio org.mobian_project.CallAudio AudioMode \
        >/dev/null 2>&1 || true
    sleep "${CALLAUDIO_WARMUP:-2}"
    return 0
}

# The four Bluetooth helpers are PartOf=graphical-session.target, so they stop
# whenever the phosh session goes down. Until 2026-09-29 they were
# WantedBy=default.target, and nothing brought them back when the session
# came up again: lmkd killed the session under memory pressure at 07:23 and
# the car stayed connected all morning without sco-hold, reconnect or pause.
# They are wanted by the session now; an older link under default.target is
# moved over here, because "is-enabled" says yes to it and nothing else would.
move_stale_want() {
    [ -L "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/default.target.wants/$1" ] || return 0
    uctl cat "$1" 2>/dev/null | grep -qx 'WantedBy=graphical-session.target' || return 0
    run uctl reenable "$1" >/dev/null 2>&1 || true
}

# The safety net has to be enabled: it discards a test profile on reboot.
# A package cannot enable it - a user unit is only enabled by the user
# themselves. So it happens here, on the first switch.
# Pausing instead of blaring: when a Bluetooth headset disconnects the audio
# would otherwise move to the loudspeaker, wherever you happen to be standing.
# Like the safety net, a user unit can only be enabled by the user.
ensure_pause_on_disconnect() {
    move_stale_want furios-audio-pause-on-disconnect.service
    uctl is-enabled furios-audio-pause-on-disconnect.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-pause-on-disconnect.service >/dev/null 2>&1; then
        run uctl enable --now furios-audio-pause-on-disconnect.service >/dev/null 2>&1 \
            && info "playback now pauses when Bluetooth disconnects"
    fi
    return 0
}

# callaudiod keeps the card index it looked up once. Every WirePlumber restart
# gives the card a new one, and the next call then blocks for 25 seconds
# instead of switching the profile - no audio in either direction. A profile
# switch takes care of it here; this unit covers every other way WirePlumber
# comes back. Like the others, only the user can enable their own unit.
ensure_callaudio_refresh() {
    uctl is-enabled furios-audio-callaudio-refresh.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-callaudio-refresh.service >/dev/null 2>&1; then
        run uctl enable furios-audio-callaudio-refresh.service >/dev/null 2>&1 \
            && info "callaudiod is refreshed when WirePlumber restarts"
    fi
    return 0
}

# A call routed to a headset is still silent without a link to carry it: the
# profile says the card CAN carry SCO, and only a stream on bluez_output makes
# one exist. Nothing opens one during a call - the voice path runs modem <->
# DSP and never reaches the host - so this service does. Measured 2026-09-12:
# same call, same routing, silent without it and heard with it.
#
# Harmless while the routing is off, because it holds nothing unless the card
# is already in a hands-free profile. Like the others, only the user can
# enable their own unit.
ensure_sco_hold() {
    move_stale_want furios-audio-sco-hold.service
    uctl is-enabled furios-audio-sco-hold.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-sco-hold.service >/dev/null 2>&1; then
        run uctl enable --now furios-audio-sco-hold.service >/dev/null 2>&1 \
            && info "the Bluetooth link is now held open during a call"
    fi
    return 0
}

# Outgoing calls on VoLTE rang in silence: the network sends no ringback tone
# (the modem says so, is_ibt=0) and nothing here made one. tonegend can, and
# furios-audio-ringback tells it when. An option like any other: off after an
# install, on only when the user switches it on - so no profile switch touches
# it, and whether the unit is enabled is the whole of its state. Not tied to a
# profile either: tonegend plays through whichever sound server runs.
# audioctl ringback [status|on|off]
ringback() {
    local want=${1:-status} u=furios-audio-ringback.service
    case "$want" in
    status)
        printf 'ringback=%s\n' "$(uctl is-enabled "$u" >/dev/null 2>&1 && echo on || echo off)"
        printf 'available=%s\n' "$(uctl cat "$u" >/dev/null 2>&1 && echo yes || echo no)"
        ;;
    on)
        uctl cat "$u" >/dev/null 2>&1 || die "furios-audio-ringback is not installed"
        run uctl enable --now "$u" >/dev/null 2>&1 || die "could not switch the ringback tone on"
        info "outgoing calls now have a ringback tone"
        ;;
    off)
        run uctl disable --now "$u" >/dev/null 2>&1 || true
        info "no ringback tone - only what the network sends"
        ;;
    *) die "ringback needs on, off or status" ;;
    esac
}

# The other half of the safety net: furios-audio-apply.service writes the
# configuration before the stack, this one checks after it. Enabled the same
# way - only the user can enable their own unit.
# A voice memo through worn earbuds records the phone on the table: A2DP has
# no microphone, and the way to the one on your ears is the hands-free
# profile, the announced codec, input-bluetooth_sco_headset and a held link -
# the four steps of "bt-mic on". This service runs them when something starts
# recording and undoes them when it stops.
#
# Harmless while furios.bluetooth-mic-routing is off, which is the default: it
# reads the setting before it touches anything. Like the others, only the user
# can enable their own unit.
ensure_bt_mic() {
    move_stale_want furios-audio-bt-mic.service
    uctl is-enabled furios-audio-bt-mic.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-bt-mic.service >/dev/null 2>&1; then
        run uctl enable --now furios-audio-bt-mic.service >/dev/null 2>&1 \
            && info "recordings can now use the Bluetooth microphone"
    fi
    return 0
}

# The other side of pause-on-disconnect: that one keeps the music off the
# loudspeaker when a headset goes, this one brings the headset back. BlueZ
# only ever dials a paired device itself when the adapter powers on or when a
# link was lost to radio trouble - earbuds that simply hung up are nobody's
# job, and on 2026-09-15 a pair sat in range and awake for over an hour while
# the phone played through its speaker. Like the others, only the user can
# enable their own unit.
ensure_bt_reconnect() {
    move_stale_want furios-audio-bt-reconnect.service
    uctl is-enabled furios-audio-bt-reconnect.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-bt-reconnect.service >/dev/null 2>&1; then
        run uctl enable --now furios-audio-bt-reconnect.service >/dev/null 2>&1 \
            && info "a headset that hangs up is now dialled back"
    fi
    return 0
}

ensure_boot_check() {
    uctl is-enabled furios-audio-verify.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-verify.service >/dev/null 2>&1; then
        run uctl enable furios-audio-verify.service >/dev/null 2>&1 \
            && info "a boot that comes up silent now falls back to standard"
    fi
    return 0
}

ensure_safety_net() {
    uctl is-enabled furios-audio-apply.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-apply.service >/dev/null 2>&1; then
        run uctl enable furios-audio-apply.service >/dev/null 2>&1 \
            && info "safety net enabled (discards test profiles on reboot)"
    fi
    return 0
}

# Our Bluetooth work - the held link, the headset microphone, dialling a
# headset back, pausing on disconnect - belongs to pw-hal. Under PulseAudio
# the phone is to behave exactly as shipped, so the shipped behaviour can be
# tested on its own (decided 27.9.2026). The units stay enabled and say so
# themselves at every start (ExecCondition, "audioctl is pw-hal"); a switch
# only has to stop or start what is running now.
PW_ONLY_HELPERS="furios-audio-pause-on-disconnect.service furios-audio-sco-hold.service furios-audio-bt-mic.service furios-audio-bt-reconnect.service"

# Our Bluetooth helpers, switchable apart from the sound server
# ("audioctl bt-extras"). Under pw-hal they are all of them: the call put on
# the headset (the Lua routing, behind furios.bluetooth-helpers), the SCO
# hold, the headset microphone, reconnect, pause on disconnect. Off there is
# WirePlumber's own Bluetooth - music, and hands-free only as far as it goes by
# itself. The ground they stand on stays: the native hands-free backend and
# ofono without its HFP plugin are what give the card a hands-free profile at
# all, and the codec choice has its own "Automatic".
#
# Under PulseAudio none of them runs, and the choice is not offered there:
# the phone stays exactly as shipped (decided 29.9.2026). Two of them had
# been allowed there before; after a day of trying, PulseAudio on this phone
# spins a core as soon as a headset is on hands-free (the Bluetooth voice
# path is the Android HAL's, and PulseAudio waits on a socket that never
# delivers), its headset microphone records nothing, and its music side
# needed mending from outside at every turn. PulseAudio is left alone; the
# Bluetooth work lives under pw-hal.
#
# Nothing chosen means on under pw-hal; a choice is kept for pw-hal whatever
# profile it was made under.
BT_HELPERS_SETTING=furios.bluetooth-helpers
BT_EXTRAS=$STATE_DIR/bt-extras

bt_extras_on() {
    case "$(cat "$BT_EXTRAS" 2>/dev/null)" in
        on)  return 0 ;;
        off) return 1 ;;
        *)   [ "$(current_profile 2>/dev/null)" = pw-hal ] ;;
    esac
}

# May this helper run now? What the units' ExecCondition asks.
helper_allowed() {
    bt_extras_on && [ "$(current_profile 2>/dev/null)" = pw-hal ]
}

# Tell WirePlumber whether the call routing may act. Only where WirePlumber
# runs the phone; quiet when it does not know the setting (an older install).
bt_extras_sync_wireplumber() {
    [ "$(current_profile 2>/dev/null)" = pw-hal ] || return 0
    wpctl settings --save "$BT_HELPERS_SETTING" \
        "$(bt_extras_on && echo true || echo false)" >/dev/null 2>&1 || true
}

pw_helpers() {
    local verb=$1 u
    for u in $PW_ONLY_HELPERS; do
        uctl is-enabled "$u" >/dev/null 2>&1 || continue
        run uctl "$verb" "$u" >/dev/null 2>&1 || true
    done
    return 0
}

# audioctl bt-extras [status|on|off]
bt_extras() {
    local want=${1:-status} p u
    p=$(current_profile 2>/dev/null)
    case "$want" in
    status)
        printf 'bt-extras=%s\n' "$(bt_extras_on && echo on || echo off)"
        printf 'profile=%s\n' "${p:-unknown}"
        # What actually runs: everything under pw-hal, nothing elsewhere or
        # when switched off. "offered" is whether there is a choice to make
        # at all - not under PulseAudio.
        if [ "$p" = pw-hal ]; then echo 'offered=yes'; else echo 'offered=no'; fi
        if bt_extras_on && [ "$p" = pw-hal ]; then echo 'effective=all'
        else echo 'effective=none'; fi
        return 0 ;;
    on|off) ;;
    *) die "bt-extras needs on, off or status" ;;
    esac
    if [ "$DRY" = 1 ]; then
        echo "[dry-run] bt-extras $want"
        return 0
    fi
    write_state "$BT_EXTRAS" "$want" || die "cannot write $BT_EXTRAS"
    ensure_pause_on_disconnect
    ensure_bt_reconnect
    if [ "$p" = pw-hal ]; then
        ensure_sco_hold
        ensure_bt_mic
        bt_extras_sync_wireplumber
        for u in $PW_ONLY_HELPERS; do
            if [ "$want" = on ]; then
                run uctl start "$u" >/dev/null 2>&1 || true
            else
                run uctl stop "$u" >/dev/null 2>&1 || true
            fi
        done
        if [ "$want" = on ]; then
            info "Bluetooth helpers on: calls on the headset, its microphone, reconnect, pause on disconnect"
        else
            info "Bluetooth helpers off: WirePlumber's own Bluetooth handling"
        fi
        return 0
    fi
    info "Bluetooth helpers $want - kept for pw-hal; under $p nothing of them runs"
}

switch_to() {
    local p=$1 mode=$2 prev
    check_legacy "$p" "$mode" || return 1
    prev=$(current_profile)
    ensure_safety_net
    ensure_boot_check
    ensure_pause_on_disconnect
    ensure_callaudio_refresh
    ensure_sco_hold
    ensure_bt_mic
    ensure_bt_reconnect
    preflight "$p"
    printf 'switching: %s -> %s (%s)\n' "$prev" "$p" "$mode"
    apply "$p"
    [ "$DRY" = 1 ] && { echo "dry run finished, nothing changed."; return 0; }

    # At boot there is nothing yet to restart and nothing yet to verify: the
    # stack starts after this, from the configuration just written. Asking
    # pactl for a sink here would time out fifteen seconds and then "fall back
    # to standard" over a stack that had simply not been started.
    if [ "$mode" = boot ]; then
        info "configuration written - systemd starts the stack from it"
        return 0
    fi

    restart_audio_clients

    if verify; then
        info "OK - sink present: $(pactl list sinks short | awk '{print $2}' | paste -sd, -)"
        info "Pulse server: $(pulse_owner)"
        # A state directory this user cannot write - the package leaves it
        # root's when it finds nobody to give it to - used to end in "set
        # persistently" after a "Permission denied" nobody reads, and the
        # next boot quietly went back to the old profile.
        local kept=0
        case "$mode" in
        sticky) rm -f "$FELL_BACK" 2>/dev/null
                if write_state "$STICKY" "$p" 2>/dev/null; then
                    rm -f "$TRY"
                    info "set persistently (survives a reboot)"
                else
                    kept=1
                    warn "switched, but $STICKY cannot be written - the next reboot goes back to '$(current_profile 2>/dev/null)'"
                fi ;;
        try)    if write_state "$TRY" "$p" 2>/dev/null; then
                    info "only until the next reboot - then back to '$(cat "$STICKY" 2>/dev/null || echo standard)'"
                else
                    kept=1
                    warn "switched, but $TRY cannot be written - status will not show this as a test"
                fi ;;
        esac
        # After the state file: the helpers' ExecCondition reads it.
        [ "$p" = pw-hal ] && { pw_helpers start; bt_extras_sync_wireplumber; }
        [ "$p" != standard ] && info "please check telephony: call, ringtone, earpiece/speaker."
        return "$kept"
    fi

    printf 'FAILED - no sink after 15s. Falling back to standard.\n' >&2
    apply standard
    rm -f "$TRY"
    verify && info "standard restored." || info "WARNING: standard does not deliver a sink either."
    return 1
}

# --- put a call on a Bluetooth headset -------------------------------------
#
# callaudiod only knows earpiece and speaker. For a headset two things have to
# come together: the headset in its hands-free profile (so an SCO channel is
# up) and the phone card on the route output-bluetooth_sco (so the HAL sends
# BT_SCO=on and puts the voice path there).
#
# The BT ports are missing from this device's audio_policy XML - they are
# commented out. Our plugin builds them itself; the HAL does not need the
# file, when routing it only gets the device type.
#
# Active ports of the respective stack. The nodes are named differently: under
# pw-hal droid-sink/droid-source, in the shipped state sink.primary_output and
# PulseAudio's droid source.
port_of() {
    local kind=$1 name
    for name in $2; do
        pactl list "$kind" 2>/dev/null | sed -n "/Name: $name\$/,/^\$/p" \
            | sed -n 's/.*Active Port: //p' | head -1 | grep . && return 0
    done
    printf '?'
}

active_ports() {
    printf '%s / %s' \
        "$(port_of sinks 'droid-sink sink.primary_output')" \
        "$(port_of sources 'droid-source source.primary_input')"
}

droid_profile() {
    pactl list cards 2>/dev/null | sed -n '/Name: droid$/,/^$/p' | sed -n 's/.*Active Profile: //p'
}

# Also writes to the journal - during a call test nobody is sitting at the
# terminal, and afterwards you want to know what really happened:
#   journalctl --user -t audioctl --since -10min
btlog() {
    printf '%s\n' "$*"
    command -v logger >/dev/null 2>&1 && logger -t audioctl -- "$*"
    return 0
}

# Which of the two Bluetooth paths is speaking. The shared helpers below are
# used by both "bt-call" and "bt-mic", and a log line that names the wrong one
# sends the next reader to the wrong place.
BTTAG=bt-call

# Force the headset into its hands-free profile so an SCO channel is up.
bt_headset_profile() {
    local card=$1 want=$2 prof ADDR
    # bluez_card.AA_BB_.. -> AA:BB:.. , so the hint below can be pasted.
    ADDR=$(printf '%s' "${card#bluez_card.}" | tr '_' ':')
    [ -n "$card" ] || return 1
    if [ "$want" = headset ]; then
        pactl set-card-profile "$card" headset-head-unit 2>/dev/null && { btlog "$BTTAG: headset profile headset-head-unit"; return 0; }
        pactl set-card-profile "$card" headset-head-unit-cvsd 2>/dev/null && { btlog "$BTTAG: headset profile headset-head-unit-cvsd (narrowband)"; return 0; }
        prof=$(pactl list cards 2>/dev/null | sed -n "/$card/,/^$/p" | sed -n 's/.*Active Profile: //p')
        btlog "$BTTAG: WARNING hands-free profile could not be set (active: ${prof:-unknown})"
        return 1
    fi
    # Going back is not guaranteed and used to be assumed. A card that lost
    # its A2DP profiles - which happens when WirePlumber restarts while
    # Bluetooth is connected, see FINDINGS.md - answers "No such entity" here,
    # and this returned 0 anyway. The headset then stays hands-free, every
    # later track plays mono at 16 kHz, and nothing anywhere says why. Seen on
    # 2026-09-13 with the card offering only "off" and the two headset
    # profiles.
    if pactl set-card-profile "$card" a2dp-sink 2>/dev/null; then
        return 0
    fi
    btlog "$BTTAG: WARNING could not go back to a2dp-sink - the headset stays in hands-free (mono, 16 kHz)."
    btlog "$BTTAG: the card usually gets its A2DP profiles back with: bluetoothctl disconnect $ADDR; bluetoothctl connect $ADDR"
    return 1
}

# Set the phone card's routes and report what actually took effect.
bt_set_ports() {
    local sink_port=$1 src_port=$2
    pactl set-sink-port   droid-sink   "$sink_port" 2>/dev/null \
        && btlog "$BTTAG: output $sink_port set" \
        || btlog "$BTTAG: ERROR - could not set output $sink_port"
    pactl set-source-port droid-source "$src_port" 2>/dev/null \
        && btlog "$BTTAG: input $src_port set" \
        || btlog "$BTTAG: ERROR - could not set input $src_port"
    btlog "$BTTAG: actually active $(active_ports)"
}

# Defend the route against callaudiod for as long as the call runs.
bt_hold() {
    # Two seconds between checks; the tests set it to zero, because a suite
    # that sleeps through half an hour of holding is a suite nobody runs.
    local sink_port=$1 src_port=$2 limit=$3 i=0 now
    local interval=${BT_HOLD_INTERVAL:-2}
    while [ $i -lt "$limit" ]; do
        [ "$interval" = 0 ] || sleep "$interval"
        now=$(pactl list sinks 2>/dev/null | sed -n '/Name: droid-sink/,/^$/p' | sed -n 's/.*Active Port: //p')
        if [ "$now" != "$sink_port" ]; then
            btlog "$BTTAG: output was on \"$now\" - setting it again"
            pactl set-sink-port   droid-sink   "$sink_port" 2>/dev/null
            pactl set-source-port droid-source "$src_port"  2>/dev/null
        fi
        # Call over? Then stop.
        [ "$(droid_profile)" = voicecall ] || return 0
        i=$((i+1))
    done
    return 0
}

# Make sound audible again - the emergency handle.
#
# Born out of a failed Bluetooth test: afterwards the output was on the
# earpiece and the volume at 18 %. Technically everything was running, nothing
# was audible. That exact combination is what rescue clears away.
rescue() {
    local to_standard=${1:-yes}
    [ "$to_standard" = yes ] && switch_to standard sticky
    pactl set-sink-mute   @DEFAULT_SINK@   0    2>/dev/null || true
    pactl set-source-mute @DEFAULT_SOURCE@ 0    2>/dev/null || true
    pactl set-sink-volume @DEFAULT_SINK@   65%  2>/dev/null || true
    # Speaker, not earpiece: on the earpiece you hear nothing unless you hold
    # the device to your ear.
    pactl set-sink-port sink.primary_output output-speaker 2>/dev/null || \
    pactl set-sink-port droid-sink          output-speaker 2>/dev/null || true
    pactl set-source-port droid-source input-builtin_mic   2>/dev/null || true
    info "sound restored: speaker, 65 %, not muted"
    info "active: $(active_ports)"
    return 0
}

bt_call() {
    local mode=$1 card waited BTTAG=bt-call
    card=$(pactl list short cards 2>/dev/null | awk '/bluez_card/ {print $2; exit}')

    # An aborted test must not leave the phone silent: Ctrl-C or an error
    # restore an audible state.
    trap 'printf "\naborted - restoring the sound.\n" >&2; rescue no; trap - INT TERM EXIT; exit 130' INT TERM

    case "$mode" in
    on)
        [ -n "$card" ] || { btlog "bt-call: no Bluetooth device connected"; return 1; }
        btlog "bt-call: card $card"
        bt_headset_profile "$card" headset
        bt_set_ports output-bluetooth_sco input-bluetooth_sco_headset
        bt_hold output-bluetooth_sco input-bluetooth_sco_headset 10
        btlog "bt-call: done, active $(active_ports)"
        printf 'Back with: audioctl bt-call off\n'
        ;;
    off)
        bt_headset_profile "$card" a2dp
        bt_set_ports output-earpiece input-builtin_mic
        ;;
    watch)
        # Start this before the call: it waits, then puts the call on the
        # headset itself and holds the route until you hang up. That way nobody
        # has to type anything while on the phone - which is exactly what made
        # the earlier attempts fail.
        [ -n "$card" ] || { btlog "bt-call watch: no Bluetooth device connected"; return 1; }
        btlog "bt-call watch: waiting for a call (abort with Ctrl-C)"
        waited=0
        while [ "$(droid_profile)" != voicecall ]; do
            sleep 1
            waited=$((waited+1))
            [ $waited -ge 600 ] && { btlog "bt-call watch: no call after 10 minutes - stopping"; return 1; }
        done
        btlog "bt-call watch: call detected after ${waited}s"
        bt_headset_profile "$card" headset
        bt_set_ports output-bluetooth_sco input-bluetooth_sco_headset
        # Hold until hang-up, at most 30 minutes.
        bt_hold output-bluetooth_sco input-bluetooth_sco_headset 900
        btlog "bt-call watch: call ended - back to the phone"
        bt_headset_profile "$card" a2dp
        bt_set_ports output-earpiece input-builtin_mic
        ;;
    *) trap - INT TERM; die "bt-call needs 'on', 'off' or 'watch'." ;;
    esac
    trap - INT TERM
    return 0
}

# --- the headset's microphone, without a call ------------------------------
#
# Music comes back from the earbuds over A2DP, and in that profile the headset
# offers no microphone at all. That is deliberate - see 51-bluez-ofono.conf:
# the node BlueZ would offer is the HOST side of SCO, and SCO does not cross
# HCI on this chip. It looks like a working microphone in every recorder and
# it records digital silence.
#
# The microphone that does work is the one the HAL reaches, and getting there
# takes the same three steps a call takes:
#
#   1. the headset into a hands-free profile, so an SCO channel exists at all
#   2. the codec told to the HAL, which otherwise encodes narrow-band CVSD
#      while the profile above negotiates wide-band mSBC - and mismatched,
#      nothing intelligible arrives
#   3. the phone card's input on input-bluetooth_sco_headset, which is what
#      makes the HAL send BT_SCO=on
#
# droid-bluetooth-call.lua does all of this already, but only when the card
# enters the voicecall profile. A voice memo is not a call, so nothing
# happened - which is exactly what this is for.
#
# It also needs a stream on bluez_output.* for as long as it records, and
# that is not obvious: 51-bluez-ofono.conf says the SCO link exists while such
# a stream is active, and a hold was built for it, and then a test seemed to
# show it was pointless - recording with the hold stopped still came back at
# 940 distinct values. It was measured inside the link the hold had just put
# up: profile, codec and route were already in place and the link was still
# standing. Coming at it cold instead - a2dp-sink, then the whole sequence
# with no hold - the same recording is 46394 samples, 1 distinct value, RMS 0.
#
# So the profile alone does not carry it, and the reading that told us
# otherwise was taken in the warmth of the thing it was meant to rule out.
#
# The price is that A2DP is gone while it lasts: the hands-free profile has no
# high-fidelity sink, so whatever plays goes out narrow-band and mono. That is
# why this is a command rather than an automatism, and why every path back
# through here puts the headset on a2dp-sink again.

# Where the hold's pid lives. The runtime directory and nowhere else: a
# predictable name in /tmp is how the last two sloppy files in this tree were
# found, and this one gets a kill sent to whatever pid it names.
sco_hold_pid_file() {
    [ -n "${XDG_RUNTIME_DIR:-}" ] || return 1
    printf '%s/furios-audio-sco-hold.pid' "$XDG_RUNTIME_DIR"
}

# The id of a PipeWire node by name.
#
# Needed because the codec below cannot go through the card: the card lives in
# WirePlumber's process and the nodes in PipeWire's, and nothing carries a card
# parameter across that on its own - measured, the node receives droid.route,
# which droid.lua sends to the node, and nothing else the card publishes.
bt_node_id() {
    pw-cli ls Node 2>/dev/null | awk -v want="$1" '
        /^[[:space:]]*id [0-9]+,/ { id = $2; sub(",", "", id); next }
        index($0, "node.name = \"" want "\"") { print id; exit }'
}

# What the Bluetooth link really runs, as BlueZ negotiated it.
#
# The headset's own nodes carry it in api.bluez5.codec, and after the profile
# switch that is the agreed codec rather than anyone's preference. It is the
# only reading here that can tell one headset from another.
bt_link_codec() {
    pw-cli ls Node 2>/dev/null | awk '
        /^[[:space:]]*id [0-9]+,/ { isbt = 0; codec = ""; next }
        index($0, "node.name = \"bluez_") > 0 { isbt = 1 }
        index($0, "api.bluez5.codec") > 0 {
            codec = $0
            sub(/.*api\.bluez5\.codec = "?/, "", codec)
            sub(/"?[[:space:]]*$/, "", codec)
        }
        isbt == 1 && codec != "" { print codec; exit }'
}

# What a card profile stands for, from the description PipeWire builds for it:
# "Headset Head Unit (HSP/HFP, codec CVSD)". Second best, because it says what
# the profile is for rather than what the link agreed - but it is there before
# the link is.
bt_profile_codec() {
    local card=${1:-} profile=${2:-}
    [ -n "$card" ] && [ -n "$profile" ] || return 0
    pactl list cards 2>/dev/null | sed -n "/Name: $card\$/,/^\$/p" \
        | sed -n "s/^[[:space:]]*$profile: .*codec \([A-Za-z0-9_-]*\).*/\1/p" | head -1
}

# Turn a codec name into the yes-or-no the HAL takes. Only mSBC and CVSD have
# an answer: bt_wbs cannot say LC3-SWB, and an A2DP node still carrying "sbc"
# is not an answer about a call at all.
bt_wbs_of_codec() {
    case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
    msbc) printf 'on' ;;
    cvsd) printf 'off' ;;
    esac
}

# Tell both phone nodes which codec the Bluetooth link runs.
#
# The HAL reads bt_wbs when it opens a stream, and it is the route that makes
# it open - so this has to happen BEFORE the route is set. Both nodes are told
# because bt_wbs belongs to the HAL module rather than to one stream, and
# either of them may be the next to open one. droid-bluetooth-call.lua says
# the same thing to the same two nodes; this is the path for everything that
# is not a call.
#
# This used to read the codec off the profile NAME, and that is wrong: the
# plain headset-head-unit is whichever codec the two ends agreed on, and only
# the per-codec profiles carry it in their name. Every hands-free device was
# therefore announced as wide-band, which is silence on a narrow-band one -
# see droid-bluetooth-call.lua for the car that paid for it.
bt_tell_codec() {
    # The card is optional: without it only the link and the profile name can
    # answer, which is what the callers outside a call have.
    local profile=${1:-} card=${2:-} wbs codec from name id told=0
    codec=$(bt_link_codec)
    wbs=$(bt_wbs_of_codec "$codec"); from="the link"
    if [ -z "$wbs" ]; then
        codec=$(bt_profile_codec "$card" "$profile")
        wbs=$(bt_wbs_of_codec "$codec"); from="the profile"
    fi
    if [ -z "$wbs" ]; then
        case "$profile" in
        *-msbc) wbs=on;  codec=msbc; from="the profile name" ;;
        *-cvsd) wbs=off; codec=cvsd; from="the profile name" ;;
        esac
    fi
    # Still nothing, and we do not guess. Guessing here is a coin toss between
    # working audio and silence, so say nothing and let the HAL keep its
    # narrow-band default - the node writes a line when it opens Bluetooth
    # without a codec, which is better than a wrong guess nobody can see.
    [ -n "$wbs" ] || { btlog "$BTTAG: codec unknown for profile \"${profile:-none}\" - the HAL keeps its default"; return 1; }
    for name in droid-sink droid-source; do
        id=$(bt_node_id "$name")
        [ -n "$id" ] || continue
        pw-cli set-param "$id" Props "{ params = [ \"droid.bt-wbs\", \"$wbs\" ] }" >/dev/null 2>&1 \
            && told=$((told+1))
    done
    [ "$told" -gt 0 ] || { btlog "$BTTAG: WARNING no node took the codec - the HAL stays on narrow-band"; return 1; }
    btlog "$BTTAG: codec bt_wbs=$wbs, $codec from $from (told $told nodes)"
    return 0
}

# What profile the Bluetooth card is actually in right now.
bt_active_profile() {
    local card=$1
    [ -n "$card" ] || return 1
    pactl list cards 2>/dev/null | sed -n "/Name: $card\$/,/^\$/p" \
        | sed -n 's/.*Active Profile: //p' | head -1
}

# Hold the SCO link up for as long as the microphone is wanted.
#
# A silent stream, and nothing of it is heard: what gets recorded comes off
# the Bluetooth link through the HAL, not through this. It is here because
# without it the HAL opens its Bluetooth capture onto a link that is not
# there and records digital silence - measured, see above.
#
# It ends by itself. A hold that outlives the recording leaves the earbuds in
# a hands-free profile, where music is narrow-band and mono, and that is the
# kind of state somebody finds hours later and blames on the headset.
bt_sco_hold_start() {
    local seconds=$1 sink pidfile pid
    pidfile=$(sco_hold_pid_file) || { btlog "$BTTAG: no XDG_RUNTIME_DIR - not holding SCO open"; return 1; }
    sink=$(pactl list short sinks 2>/dev/null | awk '/bluez_output/ {print $2; exit}')
    [ -n "$sink" ] || { btlog "$BTTAG: no Bluetooth sink - nothing to hold the link open with"; return 1; }
    bt_sco_hold_stop
    # setsid, because the hold has to outlive the audioctl that started it.
    # Without it the stream is a child of this shell and in its process group,
    # and it goes down with the command - which produced exactly one silent
    # recording here on 2026-09-12: "audioctl bt-mic on" reported the hold,
    # the recording a few minutes later came back at 1 distinct value, and the
    # status line said "not running" with the link already gone.
    #
    # timeout passes on the signal it is sent, so stopping it stops paplay.
    setsid timeout "$seconds" paplay --raw --format=s16le --rate=16000 --channels=1 \
        --device="$sink" /dev/zero >/dev/null 2>&1 </dev/null &
    pid=$!
    ( umask 077; printf '%s\n' "$pid" > "$pidfile" )
    btlog "$BTTAG: holding the link on $sink, at most ${seconds}s (pid $pid)"
    return 0
}

# The pid in the file, but only while it is still the hold.
#
# The file outlives the hold every time the hold simply runs out - "bt-mic on"
# ends it after 600 s by default, and nothing removes the file then. Its pid
# is free from that moment, and whatever process gets it next was sent the
# SIGTERM meant for the hold by the next "bt-mic off" or "bt-mic on" (and
# furios-audio-bt-mic runs "off" after every recording). The hold is
# "timeout N paplay ..." and says so in its command line; nothing else here
# does.
sco_hold_live_pid() {
    local pidfile pid
    pidfile=$(sco_hold_pid_file) || return 1
    pid=$(cat "$pidfile" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
    *paplay*) printf '%s' "$pid"; return 0 ;;
    esac
    return 1
}

bt_sco_hold_stop() {
    local pidfile pid
    pidfile=$(sco_hold_pid_file) || return 0
    [ -e "$pidfile" ] || return 0
    pid=$(sco_hold_live_pid)
    rm -f "$pidfile"
    [ -n "$pid" ] || return 0
    kill "$pid" 2>/dev/null && btlog "$BTTAG: link hold stopped"
    return 0
}

# Whether the HAL really has the Bluetooth line open.
#
# This is the one reading that cannot be talked around. The route can say
# input-bluetooth_sco_headset and the HAL can answer BT_SCO=on while the
# samples still come from the built-in microphone - measured here on
# 2026-09-12, and it reads as success all the way down to the recording. The
# BTCVSD capture device does not lie: RUNNING means the bytes are coming off
# the Bluetooth link, closed means they are coming from somewhere else.
bt_pcm_state() {
    local st
    st=$(head -1 /proc/asound/card0/pcm55c/sub0/status 2>/dev/null)
    printf '%s' "${st:-unknown}"
}

# Measure what actually arrives.
#
# "The microphone is selected" and "the microphone records something" have
# been two different things on this device more than once - a route can land
# on the wrong device and the recording still runs, perfectly, over silence.
# So the answer here is a number, and the number that matters is how many
# distinct sample values came back: one means digital silence, whatever the
# level meters say.
bt_mic_measure() {
    local seconds=${1:-3} src=${2:-droid-source} raw
    raw=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/audioctl-mic.XXXXXX") || return 1
    # pw-record and not parecord: on this stack parecord comes back with an
    # empty file and no error at all - measured, 0 bytes raw and a bare 44-byte
    # header as WAV, while pw-record on the same source in the same second
    # returned 62112 bytes. A measuring instrument that silently reads zero is
    # worse than none, because zero is exactly the answer this is looking for.
    #
    # The recording is ended by the clock, so its WAV header carries a length
    # that was never filled in. The samples are read past the header instead of
    # through it - the bytes are all there, it is only the header that is not.
    timeout "$seconds" pw-record --target "$src" --rate 16000 --channels 1 \
        --format s16 "$raw" >/dev/null 2>&1
    python3 - "$raw" <<'PY_END'
import array, os, sys
path = sys.argv[1]
try:
    with open(path, "rb") as f:
        blob = f.read()
finally:
    try: os.unlink(path)
    except OSError: pass
at = blob.find(b"data")
body = blob[at + 8:] if at >= 0 else blob[44:]
a = array.array("h")
a.frombytes(body[:len(body) // 2 * 2])
if not a:
    print("nothing was recorded at all")
    raise SystemExit(1)
peak = max(max(a), -min(a))
rms = (sum(x * x for x in a) / len(a)) ** 0.5
distinct = len(set(a))
print("%d samples, %d distinct value%s, RMS %.1f, peak %d"
      % (len(a), distinct, "" if distinct == 1 else "s", rms, peak))
if distinct <= 1:
    print("digital silence - nothing is arriving from this source")
    raise SystemExit(2)
PY_END
}

bt_mic() {
    local mode=$1 arg=${2:-} card prof BTTAG=bt-mic

    card=$(pactl list short cards 2>/dev/null | awk '/bluez_card/ {print $2; exit}')

    # An aborted run must not leave the earbuds hands-free and the phone
    # recording from nowhere. Ctrl-C puts everything back.
    trap 'printf "\naborted - putting the headset back.\n" >&2; bt_sco_hold_stop; bt_headset_profile "$card" a2dp; pactl set-source-port droid-source input-builtin_mic 2>/dev/null; trap - INT TERM EXIT; exit 130' INT TERM

    case "$mode" in
    on)
        [ -n "$card" ] || { btlog "bt-mic: no Bluetooth device connected"; trap - INT TERM; return 1; }
        btlog "bt-mic: card $card"
        bt_headset_profile "$card" headset || { trap - INT TERM; return 1; }
        prof=$(bt_active_profile "$card")
        # Before the route: the route is what makes the HAL open a stream, and
        # the codec has to be in place by then.
        bt_tell_codec "$prof" "$card"
        bt_sco_hold_start "${arg:-600}"
        pactl set-source-port droid-source input-bluetooth_sco_headset 2>/dev/null \
            && btlog "bt-mic: input input-bluetooth_sco_headset set" \
            || btlog "bt-mic: ERROR - could not set input input-bluetooth_sco_headset"
        btlog "bt-mic: active $(active_ports)"
        printf 'Recording now uses the headset. Check with: audioctl bt-mic test\n'
        printf 'Back with: audioctl bt-mic off\n'
        ;;
    off)
        bt_sco_hold_stop
        pactl set-source-port droid-source input-builtin_mic 2>/dev/null \
            && btlog "bt-mic: input input-builtin_mic set" \
            || btlog "bt-mic: ERROR - could not set input input-builtin_mic"
        bt_headset_profile "$card" a2dp
        btlog "bt-mic: active $(active_ports)"
        ;;
    test)
        # Three seconds by default: long enough to say something into the
        # headset, short enough that nobody stops reading.
        # A recording taken with no hold is silence no matter what the
        # microphone does, and it looks exactly like a broken headset.
        if ! sco_hold_live_pid >/dev/null; then
            printf 'WARNING: nothing is holding the link open - expect silence.\n' >&2
            printf '         Switch it on again with: audioctl bt-mic on\n' >&2
        fi
        printf 'Recording %s s - say something.\n' "${arg:-3}"
        # The status is taken before the trap is cleared: "trap -" succeeds,
        # and "return $?" after it returned 0 for digital silence - the one
        # answer a script calling "audioctl bt-mic test" was asking about.
        local rc=0
        bt_mic_measure "${arg:-3}" || rc=$?
        [ "$rc" -eq 0 ] || { trap - INT TERM; return "$rc"; }
        ;;
    status)
        printf 'Bluetooth card:     %s\n' "${card:-none connected}"
        printf 'Headset profile:    %s\n' "$(bt_active_profile "$card" 2>/dev/null || echo -)"
        printf 'Phone ports:        %s\n' "$(active_ports)"
        local pid
        if pid=$(sco_hold_live_pid); then
            printf 'Link hold:          running (pid %s)\n' "$pid"
        else
            printf 'Link hold:          not running\n'
        fi
        printf 'HAL Bluetooth PCM:  %s\n' "$(bt_pcm_state)"
        ;;
    *) trap - INT TERM; die "bt-mic needs 'on', 'off', 'test' or 'status'." ;;
    esac
    trap - INT TERM
    return 0
}

# --- the Bluetooth music codec ----------------------------------------------
#
# WirePlumber plays music over the best A2DP codec both ends know - AAC on
# most headsets here, and AAC is the expensive one: 7.2 % of a core against
# 4.3 % for SBC (bluebinder plus wireplumber, measured 2026-09-12). SBC sounds
# audibly worse than SBC-XQ, and SBC-XQ sounds like AAC and saves nothing.
# So it is the owner's choice, kept as the WirePlumber setting below and held
# by droid-bluetooth-codec.lua on connect, after a call and when it changes.
# No root: the setting lives in WirePlumber's own state for this user.
BT_CODEC_SETTING=furios.bluetooth-codec
BT_CODECS="auto sbc sbc_xq aac aptx aptx_hd ldac"
# Per headset, overriding the one above: "ADDRESS=codec;ADDRESS=codec".
BT_CODEC_DEVICES_SETTING=furios.bluetooth-codec-devices
# What each headset offered when it was last connected - a headset only says
# which codecs it has while it is connected, and the app wants to offer only
# those. One line per headset: address, codecs, name, tab-separated.
BT_CODEC_SEEN=${AUDIOCTL_BT_SEEN:-$USERCFG/furios-audio/bt-codecs}

# What is set, "auto" when nothing is, and nothing at all when WirePlumber
# does not know the setting - an older install, or no WirePlumber running.
bt_codec_preference() {
    local out
    out=$(wpctl settings "$BT_CODEC_SETTING" 2>/dev/null) || return 1
    printf '%s\n' "$out" | sed -n 's/^Value: "\{0,1\}\([A-Za-z0-9_]*\)"\{0,1\}.*/\1/p' | head -1
}

# The per-headset list as stored, "" when empty; fails when WirePlumber does
# not know the setting.
bt_codec_device_map() {
    local out
    out=$(wpctl settings "$BT_CODEC_DEVICES_SETTING" 2>/dev/null) || return 1
    printf '%s\n' "$out" | grep -q '^Value:' || return 1
    printf '%s\n' "$out" | sed -n 's/^Value: "\{0,1\}\([^" ]*\)"\{0,1\}.*/\1/p' | head -1
}

# The codec chosen for one headset, nothing when it follows the setting for all.
bt_codec_device_choice() {
    local addr=$1 map
    map=$(bt_codec_device_map) || return 0
    printf '%s\n' "$map" | tr ';' '\n' \
        | awk -F= -v a="$addr" 'toupper($1) == toupper(a) { print $2; exit }'
}

# bluez_card.F4_9D_8A_00_00_01 -> F4:9D:8A:00:00:01
bt_card_address() {
    printf '%s\n' "${1#bluez_card.}" | tr '_' ':' | tr '[:lower:]' '[:upper:]'
}

# The headset's own name, from the card - text from outside, so one line of
# printable characters without the separator used below.
bt_card_name() {
    local card=$1
    pactl list cards 2>/dev/null | sed -n "/Name: $card\$/,/^\$/p" \
        | sed -n 's/.*device\.description = "\(.*\)"$/\1/p' | head -1 \
        | tr -cd '[:print:]' | tr -d '|' | cut -c1-40
}

# Remember what a connected headset offers, replacing its old line.
bt_codec_remember() {
    local addr=$1 offered=$2 name=$3 rest
    [ -n "$addr" ] && [ -n "$offered" ] || return 0
    mkdir -p "$(dirname "$BT_CODEC_SEEN")" 2>/dev/null || return 0
    rest=$(grep -v "^$addr	" "$BT_CODEC_SEEN" 2>/dev/null)
    { [ -n "$rest" ] && printf '%s\n' "$rest"
      printf '%s\t%s\t%s\n' "$addr" "$offered" "$name"; } > "$BT_CODEC_SEEN.tmp" \
        && mv "$BT_CODEC_SEEN.tmp" "$BT_CODEC_SEEN"
}

# One line per A2DP profile of the card: "<profile> <codec> <available>".
# The codec comes from the description, as in the Lua script: plain a2dp-sink
# is the best codec and only its description says which.
bt_codec_profiles() {
    local card=$1
    pactl list cards 2>/dev/null | awk -v card="$card" '
        /^Card #/ { mine = 0 }
        $1 == "Name:" { mine = ($2 == card) }
        mine && $1 ~ /^a2dp-sink[^:]*:$/ {
            prof = $1; sub(/:$/, "", prof)
            codec = $0
            if (!sub(/.*, codec /, "", codec)) next
            sub(/\).*/, "", codec)
            codec = tolower(codec); gsub(/[ -]/, "_", codec)
            avail = ($0 ~ /available: no\)/) ? "no" : "yes"
            print prof, codec, avail
        }'
}

bt_codec_status() {
    local pref card active prof codec avail offered="" addr="" choice a c n
    pref=$(bt_codec_preference) || pref=""
    printf 'preference=%s\n' "${pref:-unsupported}"
    # Whether this WirePlumber knows the per-headset setting at all - an
    # older furios_audio does not, and then the app offers no headset rows.
    bt_codec_device_map >/dev/null && printf 'per_device=yes\n' || printf 'per_device=no\n'
    card=$(pactl list short cards 2>/dev/null | awk '/bluez_card/ {print $2; exit}')
    if [ -n "$card" ]; then
        printf 'card=%s\n' "$card"
        addr=$(bt_card_address "$card")
        printf 'device=%s\n' "$addr"
        active=$(bt_active_profile "$card" 2>/dev/null)
        while read -r prof codec avail; do
            [ -n "$prof" ] || continue
            [ "$avail" = yes ] && offered="$offered $codec"
            [ "$prof" = "$active" ] && printf 'active=%s\n' "$codec"
        done <<EOF
$(bt_codec_profiles "$card")
EOF
        offered=${offered# }
        printf 'offered=%s\n' "$offered"
        bt_codec_remember "$addr" "$offered" "$(bt_card_name "$card")"
    fi
    # Every headset seen so far: address|name|its own choice or "default"|
    # the codecs it offered, comma-separated.
    [ -r "$BT_CODEC_SEEN" ] || return 0
    while IFS='	' read -r a c n; do
        [ -n "$a" ] || continue
        choice=$(bt_codec_device_choice "$a")
        printf 'known=%s|%s|%s|%s\n' "$a" "${n:-$a}" "${choice:-default}" \
            "$(printf '%s' "$c" | tr ' ' ',')"
    done < "$BT_CODEC_SEEN"
}

# Set or clear one headset's own codec. "default" takes the headset out of the
# list, so it follows the setting for all again.
bt_codec_device() {
    local want=$1 addr=$2 map new got
    printf '%s\n' "$addr" | grep -qE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$' \
        || die "--device needs a Bluetooth address like F4:9D:8A:00:00:01"
    addr=$(printf '%s' "$addr" | tr '[:lower:]' '[:upper:]')
    case " $BT_CODECS default " in
    *" $want "*) ;;
    *) die "bt-codec --device needs one of: default $BT_CODECS" ;;
    esac
    map=$(bt_codec_device_map) \
        || die "WirePlumber does not know $BT_CODEC_DEVICES_SETTING - is furios_audio's 51-bluez-ofono.conf installed and WirePlumber restarted since?"
    new=$(printf '%s\n' "$map" | tr ';' '\n' \
        | awk -F= -v a="$addr" 'NF == 2 && toupper($1) != a' | paste -sd';' -)
    [ "$want" = default ] || new="${new:+$new;}$addr=$want"
    if [ "$DRY" = 1 ]; then
        echo "[dry-run] wpctl settings --save $BT_CODEC_DEVICES_SETTING ${new:-\"\"}"
        return 0
    fi
    wpctl settings --save "$BT_CODEC_DEVICES_SETTING" "${new:-\"\"}" >/dev/null 2>&1
    got=$(bt_codec_device_choice "$addr")
    [ "${got:-default}" = "$want" ] \
        || die "WirePlumber did not take the setting for $addr (it says: ${got:-nothing})"
    info "Bluetooth codec for $addr: $want"
}

bt_codec() {
    local want=${1:-status} got
    case "$want" in
    status) bt_codec_status; return 0 ;;
    esac
    if [ "${2:-}" = --device ]; then
        bt_codec_device "$want" "${3:-}"
        return
    fi
    case " $BT_CODECS " in
    *" $want "*) ;;
    *) die "bt-codec needs one of: status $BT_CODECS" ;;
    esac
    if [ "$DRY" = 1 ]; then
        echo "[dry-run] wpctl settings --save $BT_CODEC_SETTING $want"
        return 0
    fi
    wpctl settings --save "$BT_CODEC_SETTING" "$want" >/dev/null 2>&1
    # wpctl answers 0 for a setting it does not know, so the answer is read
    # back rather than trusted.
    got=$(bt_codec_preference) || got=""
    [ "$got" = "$want" ] \
        || die "WirePlumber did not take the setting (it says: ${got:-nothing}) - is furios_audio's 51-bluez-ofono.conf installed and WirePlumber restarted since?"
    info "Bluetooth codec: $want"
}

# --- the record of what was there before, and putting it back --------------
#
# See the block at the top, next to ORIG_USER_DIR, and tools/original-state.sh.

# Every path under $HOME that audioctl or install.sh's "systemctl --user
# enable" writes, one per line: "f <path>" for files and links, "t <path>" for
# a directory that is state as a whole, "d <path>" for a directory we only
# put things into.
original_user_paths() {
    local u t
    printf 'd %s\n' "$USERCFG/systemd" "$ETCU" "$ETCU/pipewire.service.d" \
        "$ETCU/pipewire.service.wants" "$(dirname "$WPUSER")" "$WPUSER"
    for t in $OUR_WANT_TARGETS; do printf 'd %s\n' "$ETCU/$t.wants"; done
    for u in pipewire-pulse.service pipewire-pulse.socket wireplumber.service \
             pulseaudio.service pulseaudio.socket; do
        printf 'f %s\n' "$ETCU/$u"
    done
    printf 'f %s\n' "$DROPIN" "$WPOFF" \
        "$ETCU/pipewire.service.wants/wireplumber.service" \
        "$ETCU/pipewire-session-manager.service"
    for t in $OUR_WANT_TARGETS; do
        for u in $OUR_USER_UNITS; do printf 'f %s\n' "$ETCU/$t.wants/$u"; done
    done
    printf 't %s\n' "$WPSTATE"
}

# Is what is at this path now something audioctl (or an older version of it)
# put there? Asked when the record is taken - then it means "an older install
# was here first" - and on the way out, where it means "still ours".
original_is_ours() {
    local p=$1
    case "$p" in
    "$ETCU"/pulseaudio.service|"$ETCU"/pulseaudio.socket|"$ETCU"/pipewire-pulse.service|\
    "$ETCU"/pipewire-pulse.socket|"$ETCU"/wireplumber.service)
        [ ! -e "$p" ] && [ ! -L "$p" ] && return 0
        { [ -L "$p" ] && [ "$(readlink "$p")" = /dev/null ]; } || is_shadow "$p" ;;
    "$DROPIN")
        [ ! -e "$p" ] || grep -q 'pipewire-hal\.conf' "$p" 2>/dev/null ;;
    "$WPOFF")
        [ ! -e "$p" ] || grep -q 'Written by audioctl' "$p" 2>/dev/null ;;
    "$ETCU/pipewire.service.wants/wireplumber.service"|"$ETCU/pipewire-session-manager.service")
        # "enable wireplumber.service" writes both, "disable" removes both.
        [ ! -e "$p" ] && [ ! -L "$p" ] && return 0
        [ -L "$p" ] && [ "$(basename "$(readlink "$p")")" = wireplumber.service ] ;;
    "$ETCU"/*.wants/furios-*)
        [ ! -e "$p" ] || [ -L "$p" ] ;;
    "$WPSTATE")
        # Everything WirePlumber keeps is from a WirePlumber that ran because
        # of us - FuriOS ships it masked.
        return 0 ;;
    *) return 1 ;;
    esac
}

# Did an older version of this set the phone up before there was a record?
# Then what is there now is not an original, and the record says "unknown".
#
# Only by what nobody but audioctl writes: its drop-in, its droid-off file, a
# copy with its marker, a want of one of our units, a furios.* setting.
# NOT a mask - a link to /dev/null is what anybody's "systemctl --user mask"
# makes, and taking the user's own mask of pulseaudio.socket for an old
# install of ours threw away their WirePlumber want and state with it.
original_legacy_install() {
    local u t
    { [ -e "$DROPIN" ] || [ -e "$WPOFF" ]; } && return 0
    for u in pipewire-pulse.service pipewire-pulse.socket wireplumber.service \
             pulseaudio.service pulseaudio.socket; do
        is_shadow "$ETCU/$u" && return 0
    done
    for t in $OUR_WANT_TARGETS; do
        for u in $OUR_USER_UNITS; do [ -L "$ETCU/$t.wants/$u" ] && return 0; done
    done
    grep -qs '^furios\.' "$WPSTATE/sm-settings"
}

# Before the first write. Every call after that finds the record and leaves it.
# uninstall.sh switches back with AUDIOCTL_NO_RECORD=1: a record taken on the
# way out would be of our own state, and would hide that there was none.
record_originals() {
    [ "$DRY" = 1 ] && return 0
    [ -n "${AUDIOCTL_NO_RECORD:-}" ] && return 0
    [ "$ORIG_OFF" = 1 ] && return 0
    if [ "$ORIG_OK" != 1 ]; then
        warn "original-state.sh not found - what is here before this switch is not recorded"
        return 0
    fi
    local ORIG_DIR=$ORIG_USER_DIR ORIG_SU= kind p flag legacy=0
    # Cheap when done: the last path is the one written last.
    orig_has_record "$WPSTATE" && return 0
    original_legacy_install && legacy=1
    while read -r kind p; do
        orig_has_record "$p" && continue
        flag=
        case "$kind" in
        d)  [ "$legacy" = 1 ] && flag=--ours-if-present
            orig_record_dir "$p" $flag ;;
        *)  # Ours by what it is, or - for WirePlumber's want and its state -
            # there because an older version of this ran it.
            # Only after an older install: on a phone audioctl never touched,
            # whatever is there is the user's, however much it looks like ours.
            if [ "$legacy" = 1 ] && { [ -e "$p" ] || [ -L "$p" ]; } && original_is_ours "$p"; then
                flag=--ours-if-present
            fi
            orig_record "$p" $flag ;;
        esac || warn "could not record $p"
    done < <(original_user_paths)
    [ "$legacy" = 1 ] && info "set up by an older version: what it wrote is recorded as unknown"
    return 0
}

# audioctl original [status|record|restore]
original() {
    local ORIG_DIR=$ORIG_USER_DIR ORIG_SU= kind p rc=0
    [ "$ORIG_OK" = 1 ] || die "original-state.sh not found - cannot $1"
    case "${1:-status}" in
    record) record_originals ;;
    status)
        [ -d "$ORIG_DIR/meta" ] || { echo "no record - nothing written yet, or set up by an older version"; return 0; }
        while read -r kind p; do
            if orig_has_record "$p"; then
                printf '%-18s %s\n' "$(orig_recorded "$p" | cut -d' ' -f1)" "$p"
            else
                printf '%-18s %s\n' "-" "$p"
            fi
        done < <(original_user_paths) ;;
    restore)
        # The running stack is not touched here: uninstall.sh has already
        # switched back to standard and stopped our units.
        [ "$ORIG_OFF" = 1 ] && { warn "no record directory for these overrides"; return 3; }
        if [ ! -d "$ORIG_DIR/meta" ]; then
            warn "no record of what was here before audioctl (set up by an older version)"
            return 3
        fi
        orig_restore_all original_is_ours || rc=1
        # Directories last and only once they are empty; the record's own
        # ordering already does that for the ones it knows.
        return "$rc" ;;
    *) die "original needs status, record or restore" ;;
    esac
}

usage() {
    cat <<EOF
audioctl - switch the audio stack

  audioctl status              show the current state
  audioctl toggle              switch: standard <-> pw-hal (in test mode)
  audioctl list                list the profiles
  audioctl is <profile>        exit 0 if that is the stored profile
  audioctl try <profile>       switch, falls back on reboot
  audioctl set <profile>       switch and remember persistently
  audioctl restart             restart the audio stack, keep the profile
  audioctl rescue              make sound audible again: shipped state,
                               speaker, 65 %, not muted
  audioctl bt-call watch       start before the call: puts the call on the
                               Bluetooth headset itself and holds it there
  audioctl bt-call on|off      move a running call by hand
  audioctl bt-mic on|off       record from the Bluetooth headset outside a
                               call (a voice memo); music turns narrow-band
                               while it is on, so put it back afterwards
  audioctl bt-mic test [s]     record a few seconds and say what arrived
  audioctl bt-mic on [s]       hold the link for s seconds (default 600)
  audioctl bt-mic status       headset profile, phone ports, link hold, and
                               whether the HAL has the Bluetooth line open
  audioctl bt-codec [status]   music codec for Bluetooth headsets: what is
                               chosen, what the connected headset offers
  audioctl bt-codec <codec>    auto (WirePlumber's best), sbc, sbc_xq, aac,
                               aptx, aptx_hd or ldac - applies at once
  audioctl bt-extras [status|on|off]
                               Bluetooth helpers outside pw-hal: pause on
                               disconnect and reconnect, the two that need no
                               WirePlumber (under pw-hal all of them run)
  audioctl ringback [status|on|off]
                               the ringback tone for outgoing calls on
                               networks that send none (off until switched on)
  audioctl bt-codec <codec> --device <address>
                               the same for one headset only; "default" makes
                               it follow the setting for all again
  audioctl revert              back to standard immediately
  audioctl boot                write the stored profile's configuration
                               without starting anything (used at boot)
  audioctl boot-check          after the stack: fall back to standard if the
                               profile came up without a sink (used at boot)
  audioctl original [status|record|restore]
                               what was here before audioctl first changed
                               anything, and putting exactly that back
                               (uninstall.sh does)
  sudo audioctl migrate        once, if an older version left system-wide
                               state behind (it says so when it matters)
  audioctl verify              check whether a sink is there

  --dry-run                    only show what would happen

Profiles:
  standard    FuriOS as shipped: PulseAudio holds the HAL, PipeWire does video
  pw-tunnel   like standard, plus a PipeWire tunnel sink (telephony untouched)
  pw-hal      PipeWire holds the HAL via the SPA droid plugin (playback, capture
              and telephony confirmed on the device)
EOF
}

# Our ofono drop-in replaces ofonod's command line to drop one plugin. It was
# written against the shipped "/usr/sbin/ofonod --nodetach"; if FuriLabs
# changes that line, ours silently wins over theirs - and that is the modem.
OFONO_UNIT=${AUDIOCTL_OFONO_UNIT:-/usr/lib/systemd/system/ofono.service}
OFONO_DROPIN=${AUDIOCTL_OFONO_DROPIN:-/etc/systemd/system/ofono.service.d/30-furios-audio-hfp.conf}
# The oFono drop-in replaces the vendor's ExecStart. If FuriLabs change that
# line, ours silently wins over theirs: say so. Prints the vendor's command
# when it differs, nothing when all is as expected.
ofono_dropin_conflict() {
    local vendor
    [ -r "$OFONO_DROPIN" ] && [ -r "$OFONO_UNIT" ] || return 0
    vendor=$(sed -n 's/^ExecStart=//p' "$OFONO_UNIT" | tail -1)
    [ "$vendor" = "/usr/sbin/ofonod --nodetach" ] || printf '%s' "$vendor"
}

# One line for status: is the +CLCC fix going to be in the plugin? Prints
# "applied", "not-applied <reason>" or nothing when the helper is not
# installed (then there is no drop-in either, and nothing to report). Takes
# the helper's --check output when the caller already has it.
bluez5_fix_status() {
    local out state reason
    [ -e "$BLUEZ5_FIX" ] || return 0
    out=${1-$(bluez5_fix_check)} || true
    state=$(printf '%s\n' "$out" | sed -n 's/^clcc=//p' | head -1)
    reason=$(printf '%s\n' "$out" | sed -n 's/^clcc-reason=//p' | head -1)
    case "$state" in
    applied)     printf 'applied' ;;
    not-applied) printf 'not-applied %s' "${reason:-unknown reason}" ;;
    *)           printf 'not-applied the helper gave no answer' ;;
    esac
}

# The same for the AAC module: "loaded", "stale <reason>", "absent", or
# nothing without the helper. A module left in the system directory by an
# older build comes on a second line as "legacy <path>".
aac_status() {
    local out state reason legacy
    [ -e "$BLUEZ5_FIX" ] || return 0
    out=${1-$(bluez5_fix_check)} || true
    state=$(printf '%s\n' "$out" | sed -n 's/^aac=//p' | head -1)
    reason=$(printf '%s\n' "$out" | sed -n 's/^aac-reason=//p' | head -1)
    legacy=$(printf '%s\n' "$out" | sed -n 's/^aac-legacy=//p' | head -1)
    case "$state" in
    loaded|absent) printf '%s' "$state" ;;
    stale)         printf 'stale %s' "${reason:-unknown reason}" ;;
    *)             printf 'absent' ;;
    esac
    [ -n "$legacy" ] && printf '\nlegacy %s' "$legacy"
    return 0
}

STATUS_UNITS="pulseaudio.service pipewire.service pipewire-pulse.service wireplumber.service furios-pw-tunnel.service"

json_str() {
    local v=${1//\\/\\\\}
    v=${v//\"/\\\"}
    printf '"%s"' "$v"
}

# For the app: the same answers as "status", as JSON, so the window does not
# depend on how a line for people is worded.
status_json() {
    local eff rec sticky fell sinks u first=1 conflict bz aac chk
    eff=$(effective_profile)
    rec=$(current_profile)
    sticky=$(cat "$STICKY" 2>/dev/null || echo standard)
    fell=$(cat "$FELL_BACK" 2>/dev/null || true)
    conflict=$(ofono_dropin_conflict)
    printf '{\n'
    printf '  "profile": %s,\n' "$(json_str "$eff")"
    printf '  "recorded": %s,\n' "$(json_str "$rec")"
    printf '  "persistent": %s,\n' "$(json_str "$sticky")"
    printf '  "test_mode": %s,\n' "$([ -r "$TRY" ] && echo true || echo false)"
    printf '  "fell_back": %s,\n' "$([ -n "$fell" ] && json_str "$fell" || echo null)"
    printf '  "ofono_dropin_conflict": %s,\n' "$([ -n "$conflict" ] && json_str "$conflict" || echo null)"
    printf '  "pulse_server": %s,\n' "$(json_str "$(pulse_owner)")"
    chk=$(bluez5_fix_check)
    bz=$(bluez5_fix_status "$chk")
    aac=$(aac_status "$chk" | head -1)
    printf '  "bluez5_fix": %s,\n' "$([ -n "$bz" ] && json_str "$bz" || echo null)"
    printf '  "aac_module": %s,\n' "$([ -n "$aac" ] && json_str "$aac" || echo null)"
    printf '  "sinks": ['
    sinks=$(pactl list sinks short 2>/dev/null | awk '{print $2}')
    for u in $sinks; do
        [ $first = 1 ] || printf ', '
        first=0; json_str "$u"
    done
    printf '],\n  "units": {'
    first=1
    for u in $STATUS_UNITS; do
        [ $first = 1 ] || printf ','
        first=0
        printf '\n    %s: {"enabled": %s, "active": %s}' "$(json_str "$u")" \
            "$(json_str "$(uctl is-enabled "$u" 2>&1 | head -1)")" \
            "$(json_str "$(uctl is-active "$u" 2>&1 | head -1)")"
    done
    printf '\n  }\n}\n'
}

# modemctl's form, like every misc-de ctl: a heading per part, ok / FAIL /
# warn / -- in front of each line, colour only when somebody is watching, and
# a closing line naming the fix. Exit 1 when something does not work.
status() {
    [ "${1:-}" = --json ] && { status_json; return 0; }
    local eff rec sticky fell conflict sinks server u en ac problems=0 fix= bz aac chk
    local c_ok= c_bad= c_warn= c_b= c_0=
    if [ -t 1 ]; then
        c_ok=$'\033[32m'; c_bad=$'\033[31m'; c_warn=$'\033[33m'; c_b=$'\033[1m'; c_0=$'\033[0m'
    fi
    _head() { printf '%s%s== %s%s\n' "${2-$'\n'}" "$c_b" "$1" "$c_0"; }
    _ok()   { printf '  %sok%s    %s\n' "$c_ok" "$c_0" "$*"; }
    _bad()  { printf '  %sFAIL%s  %s\n' "$c_bad" "$c_0" "$*"; problems=$((problems + 1)); }
    _warn() { printf '  %swarn%s  %s\n' "$c_warn" "$c_0" "$*"; }
    _skip() { printf '  --    %s\n' "$*"; }

    eff=$(effective_profile)
    rec=$(current_profile)
    sticky=$(cat "$STICKY" 2>/dev/null || echo standard)
    fell=$(cat "$FELL_BACK" 2>/dev/null || true)
    conflict=$(ofono_dropin_conflict)

    _head profile ""
    if [ "$eff" != "$rec" ]; then
        _bad "$eff running, but $rec recorded"
        fix="audioctl set $eff"
    elif [ "$eff" = "$sticky" ]; then
        _ok "$eff - running and kept after a reboot"
    else
        _ok "$eff running"
    fi
    if [ -r "$TRY" ]; then
        _warn "test mode - back to $sticky at the next reboot"
    elif [ "$eff" != "$sticky" ]; then
        _skip "after a reboot: $sticky"
    fi
    [ -n "$fell" ] && _warn "fell back at boot: $fell - that profile gave no phone output"
    if [ -n "$conflict" ]; then
        _bad "ofono.service now starts \"$conflict\", and our drop-in replaces that"
        printf '        remove %s, or reinstall furios_audio once it knows the new line\n' "$OFONO_DROPIN"
    fi

    _head "sound server"
    server=$(pulse_owner)
    if [ "$server" = "not reachable" ]; then
        _bad "Pulse server not reachable"
        fix=${fix:-audioctl restart}
    else
        _ok "$server"
    fi
    sinks=$(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, -)
    if [ -n "$sinks" ]; then
        _ok "sinks: ${sinks//,/, }"
    elif [ "$server" != "not reachable" ]; then
        _bad "no sinks - nothing to play to"
        fix=${fix:-audioctl restart}
    fi

    chk=$(bluez5_fix_check)
    bz=$(bluez5_fix_status "$chk")
    if [ -n "$bz" ]; then
        _head bluetooth
        case "$bz" in
        applied) _ok "bluez5 fix applied - car kits see the call as call 1" ;;
        *)       _warn "bluez5 fix not applied: ${bz#not-applied }"
                 printf '        a car kit will not see calls - see furios-audio-bluez5-fix --check\n' ;;
        esac
        while IFS= read -r aac; do
            case "$aac" in
            loaded)   _ok "AAC module loaded" ;;
            absent)   _skip "no AAC module built - tools/build-bluez5-aac.sh" ;;
            stale\ *) _warn "AAC module not loaded, stale: ${aac#stale }" ;;
            legacy\ *)
                _bad "an older AAC build in ${aac#legacy } is loaded whatever PipeWire it was built for"
                fix=${fix:-sudo audioctl migrate} ;;
            esac
        done <<< "$(aac_status "$chk")"
    fi

    _head units
    for u in $STATUS_UNITS; do
        en=$(uctl is-enabled "$u" 2>&1 | head -1)
        ac=$(uctl is-active "$u" 2>&1 | head -1)
        if [ "$ac" = failed ]; then
            _bad "$(printf '%-28s %-10s %s' "$u" "$en" "$ac")"
            fix=${fix:-audioctl restart}
        elif [ "$ac" = active ]; then
            _ok "$(printf '%-28s %-10s %s' "$u" "$en" "$ac")"
        else
            _skip "$(printf '%-28s %-10s %s' "$u" "$en" "$ac")"
        fi
    done

    printf '\n'
    if [ "$problems" -eq 0 ]; then
        printf 'everything in place\n'
        return 0
    fi
    printf '%d problem(s)%s\n' "$problems" "${fix:+ - fix with: $fix}"
    return 1
}

# Sourcing this file with AUDIOCTL_LIB=1 gives access to the functions without
# running anything - that is how tests/test-audioctl.sh gets at verify() and
# effective_profile() with stubbed pactl and systemctl.
if [ -n "${AUDIOCTL_LIB:-}" ]; then
    return 0 2>/dev/null || exit 0
fi

# Root is wrong for everything here except the one-off migration: the state
# audioctl writes belongs to the user whose session it is. Checked here rather
# than at the top of the file, because sourcing this as a library must not end
# in an exit.
if [ "$(id -un)" = root ] && [ "${1:-}" != migrate ]; then
    die "please run as the furios user, not as root - nothing here needs it (except 'audioctl migrate', once)."
fi

# migrate is the one thing here that runs as root, and it deletes files. An
# environment variable that moves where it looks would make it a way of
# deleting any file at all, under a friendly name. The tests need those
# overrides and therefore run unprivileged - which works because everything
# else in here tests whether it can write rather than testing id -u.
if [ "$(id -u)" -eq 0 ]; then
    for _v in AUDIOCTL_ETCU AUDIOCTL_LIB AUDIOCTL_STATE_DIR AUDIOCTL_WPCONF_DIR \
              AUDIOCTL_LEGACY_ETCU AUDIOCTL_LEGACY_WP AUDIOCTL_VENDOR_UNITS \
              AUDIOCTL_PLUGIN_DIR AUDIOCTL_PW_MODULE_DIR AUDIOCTL_BLUEZ5_FIX \
              AUDIOCTL_LEGACY_SPA \
              AUDIOCTL_ORIGINAL_DIR AUDIOCTL_WPSTATE_DIR; do
        if [ -n "${!_v:-}" ]; then
            die "refusing to honour $_v as root - that would make this a way of deleting arbitrary files."
        fi
    done
fi

args=(); for a in "$@"; do [ "$a" = --dry-run ] && DRY=1 || args+=("$a"); done
set -- ${args+"${args[@]}"}
# Every command that writes something under $HOME records first what is there
# - once; after the first time this finds the record and returns.
case "${1:-status}" in
    toggle|try|set|boot|boot-check|restart|revert) record_originals ;;
    bt-extras) case "${2:-status}" in on|off) record_originals ;; esac ;;
    bt-codec)  case "${2:-status}" in status) ;; *) record_originals ;; esac ;;
esac
case "${1:-status}" in
    status) status "${2:-}" ;;
    # Toggle: deliberately in test mode, so a reboot always leads back to the
    # shipped state.
    toggle) if [ "$(effective_profile)" = pw-hal ]; then
                switch_to standard sticky
            else
                switch_to pw-hal try
            fi ;;
    list)   printf '%s\n' $PROFILES ;;
    # For ExecCondition: exit 0 when the stored profile is the one named.
    helper-allowed) [ $# -ge 2 ] || die "unit missing."; helper_allowed "$2" ;;
    bt-extras) bt_extras "${2:-status}" ;;
    ringback)  ringback "${2:-status}" ;;
    is)     [ $# -ge 2 ] || die "profile missing."
            [ "$(current_profile 2>/dev/null)" = "$2" ] ;;
    try)    [ $# -ge 2 ] || die "profile missing."; switch_to "$2" try ;;
    set)    [ $# -ge 2 ] || die "profile missing."; switch_to "$2" sticky ;;
    # What furios-audio-apply.service runs before the stack starts: drop the
    # test-mode marker, so a test profile never survives a reboot, and write
    # the configuration for the stored profile. Starts nothing - see uctl().
    # The test marker goes first, so current_profile() reads the STORED
    # profile below and not the one that must not survive a reboot.
    boot)   BOOT=1
            rm -f "$TRY"
            switch_to "$(current_profile)" boot ;;
    # And the other half, from furios-audio-verify.service: run after the
    # stack, when there is finally something to ask.
    boot-check) boot_check ;;
    # Restart without changing the profile - for instance so the HAL re-reads a
    # modified tuning file.
    restart) p=$(effective_profile)
             [ "$p" = unclear ] && p=$(current_profile)
             # apply() knows three profiles and silently does nothing for
             # anything else, so a stack that could not be identified used to
             # end in "no sink after the restart" with no hint as to why. And
             # the preconditions belong here as much as in a switch: restarting
             # into pw-hal without the plugin present is the same silent phone.
             known_profile "$p" || die "cannot tell which profile is running - try \"audioctl set standard\"."
             preflight "$p"
             printf 'restarting the audio stack (profile %s)\n' "$p"
             apply "$p"
             verify && info "OK - sink present: $(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, -)" \
                    || printf 'WARNING: no sink after the restart.\n' >&2 ;;
    rescue) rescue ;;
    bt-call) [ $# -ge 2 ] || die "bt-call needs 'on', 'off' or 'watch'."; bt_call "$2" ;;
    bt-mic) [ $# -ge 2 ] || die "bt-mic needs 'on', 'off', 'test' or 'status'."; bt_mic "$2" "${3:-}" ;;
    bt-codec) bt_codec "${2:-status}" "${3:-}" "${4:-}" ;;
    revert) switch_to standard sticky ;;
    migrate) migrate_legacy ;;
    original) original "${2:-status}" ;;
    verify) verify && echo "OK - sink present." || { echo "no sink." >&2; exit 1; } ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
