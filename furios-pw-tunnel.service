[Unit]
Description=FuriOS Audio: PipeWire tunnel to PulseAudio (profile pw-tunnel)
After=pipewire.service pulseaudio.service
BindsTo=pipewire.service

# Five starts 2 s apart need 10 s, and the default window is ten - so the
# limit could never be reached and a permanent fault meant restarting every
# 2 s for the uptime of the phone. Giving up is right here: it belongs to one profile, and audioctl has its own net under that.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Both places, like apply and verify: install.sh puts tunnel.conf under
# /usr/local, the package under /usr. This used to name /usr/local only, so on
# a package install audioctl's preflight found the file (it looks in both),
# enabled this unit, and the unit failed at every start - the pw-tunnel
# profile could never come up from the .deb.
ExecStart=/bin/sh -c 'c=/usr/local/share/furios-audio/tunnel.conf; test -e "$$c" || c=/usr/share/furios-audio/tunnel.conf; exec /usr/bin/pipewire -c "$$c"'
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=default.target
