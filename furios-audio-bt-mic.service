[Unit]
# Puts the Bluetooth headset into its hands-free profile while something is
# recording, so that a voice memo uses the microphone on your ears instead of
# the phone lying on the table. The four steps themselves are audioctl's
# ("audioctl bt-mic on"); this service is only the question of when.
#
# It stays out of calls: droid-bluetooth-call.lua and furios-audio-sco-hold
# own the card while one is up.
Description=Record through the Bluetooth headset outside a call
PartOf=graphical-session.target

# The rate limit is off on purpose, as for the other supervisors. This one
# ends every time the sound server goes away - every profile switch, every
# WirePlumber crash - and pactl cannot subscribe until the server is back.
# It used to give up after five starts in two minutes on the grounds that it
# is "started on demand"; it is not, it is enabled at login, and nobody
# starts it again by hand. A server that took longer than 25 s to return
# would have left recordings unwatched until the next boot.
StartLimitIntervalSec=0

[Service]
# PipeWire only: under PulseAudio the phone behaves as shipped. Skipped, not
# failed, when another profile is stored - see PW_ONLY_HELPERS in audioctl.
ExecCondition=/bin/sh -c 'for a in /usr/local/bin/audioctl /usr/bin/audioctl; do [ -x "$$a" ] && exec "$$a" helper-allowed furios-audio-bt-mic.service; done; exit 1'
Type=simple
ExecStart=/usr/bin/furios-audio-bt-mic
Restart=on-failure
RestartSec=5

# Backoff instead of giving up: RestartSteps stretches the delay from
# RestartSec up to RestartMaxDelaySec, so a permanent fault settles at one
# start every five minutes rather than one every 5 seconds, while a
# transient one still recovers on its own.
RestartSteps=5
RestartMaxDelaySec=300

[Install]
WantedBy=graphical-session.target
